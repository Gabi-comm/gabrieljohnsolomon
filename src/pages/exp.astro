---
/**
 * Full experience page — every role on the timeline, plus awards and affiliations.
 * The home page shows a capped teaser (see components/Experience.astro).
 */
import Layout from '../layouts/Layout.astro';
import ExperienceBody from '../components/ExperienceBody.astro';
---

<Layout
	title="Experience"
	description="Gabriel John Solomon's full experience — AI security, student leadership, community data work, awards and affiliations."
>
	<div class="exp-page">
		<header class="page-head">
			<p class="eyebrow">Experience</p>
			<h1 class="page-title">Roles & leadership</h1>
		</header>

		<ExperienceBody />
	</div>
</Layout>

<style>
	.exp-page {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-top: clamp(5.5rem, 12vw, 8rem);
		padding-bottom: clamp(3.5rem, 9vw, 6rem);
		box-sizing: border-box;
	}

	.page-head {
		text-align: center;
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.eyebrow {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--pp);
		margin: 0 0 0.6rem;
	}

	.page-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(2rem, 6vw, 3.1rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0;
	}
</style>
