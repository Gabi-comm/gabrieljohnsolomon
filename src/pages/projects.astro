---
/**
 * Projects gallery.
 *
 * A sticky toolbar (search box + category chips) filters a joined newspaper
 * grid of project listings entirely client-side — no round-trips, so filtering is instant and
 * works on the static deploy. Data comes from `src/data/projects.ts`; the pill set
 * is the subset of CATEGORY_ORDER actually used by at least one project, so no pill
 * ever shows zero results on load.
 *
 * Progressive enhancement: with JS off, every card is simply visible. The script
 * only ever hides cards, never creates them.
 */
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { projects, GITHUB_USER, CATEGORY_ORDER, projectImage } from '../data/projects';

const repoUrl = (slug: string) => `https://github.com/${GITHUB_USER}/${slug}`;

// Sort: featured first, then newest, then alphabetical — a deterministic order that
// puts the strongest work up top on first paint.
const sorted = [...projects].sort((a, b) => {
	if (Boolean(b.featured) !== Boolean(a.featured)) return a.featured ? -1 : 1;
	if (b.year !== a.year) return b.year - a.year;
	return a.title.localeCompare(b.title);
});

// Only show pills for categories that at least one project actually uses.
const used = new Set(projects.flatMap((p) => p.categories));
const categories = CATEGORY_ORDER.filter((c) => used.has(c));

const counts = Object.fromEntries(
	categories.map((c) => [c, projects.filter((p) => p.categories.includes(c)).length])
);

// A small language → dot-colour map so the footer dot reads at a glance.
const langColor: Record<string, string> = {
	TypeScript: '#3178c6',
	JavaScript: '#f1e05a',
	Python: '#3572a5',
	'Jupyter Notebook': '#da5b0b',
	HTML: '#e34c26',
	CSS: '#563d7c',
	Shell: '#89e051',
	Astro: '#ff5a03',
};
---

<Layout
	title="Projects"
	description="Machine learning, computer vision, LLM, and cybersecurity projects built by Gabriel John Solomon — filter the full gallery by category or search."
>
	<div class="page projects-page">
		<PageHead
			title="The Work"
		/>

		<!-- Sticky filter toolbar -->
		<div class="toolbar" role="search">
			<div class="search">
				<svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"
					stroke="currentColor">
					<circle cx="11" cy="11" r="7" stroke-width="2"></circle>
					<path d="m21 21-4.3-4.3" stroke-width="2" stroke-linecap="round"></path>
				</svg>
				<input
					id="project-search"
					type="search"
					placeholder="Search projects, stacks, keywords…"
					autocomplete="off"
					aria-label="Search projects"
				/>
				<button id="search-clear" type="button" class="search-clear" aria-label="Clear search" hidden>
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
						<path d="M18 6 6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<div class="pills" role="group" aria-label="Filter by category">
				<button class="pill active" type="button" data-cat="all" aria-pressed="true">
					All <span class="count">{projects.length}</span>
				</button>
				{
					categories.map((c) => (
						<button class="pill" type="button" data-cat={c} aria-pressed="false">
							{c} <span class="count">{counts[c]}</span>
						</button>
					))
				}
			</div>
		</div>

		<!-- Reserves the fixed toolbar's vertical space in normal flow; its height is
		     set in JS so wrapping pills never hide the cards behind the bar. -->
		<div id="toolbar-spacer" aria-hidden="true"></div>

		<p class="result-line" aria-live="polite">
			Showing <span id="result-count" class="dot-type">{sorted.length}</span> of {projects.length} projects
		</p>

		<div class="grid" id="project-grid">
			{
				sorted.map((p) => (
					<article
						class="card reveal"
						data-categories={p.categories.join('|')}
						data-haystack={`${p.title} ${p.blurb} ${p.tags.join(' ')} ${p.categories.join(' ')} ${p.language}`.toLowerCase()}
					>
						<figure class="card-shot">
							<img
								src={projectImage(p.slug)}
								alt=""
								width="1200"
								height="750"
								loading="lazy"
								decoding="async"
							/>
						</figure>

						<div class="card-head">
							<span class="card-no dot-type" aria-hidden="true" />
							<span class="repo-mark" aria-hidden="true" />
							{p.status && <span class="status">{p.status}</span>}
							{p.featured && <span class="featured-dot" title="Featured">★</span>}
						</div>

						<h2 class="card-title">
							<a href={`/projects/${p.slug}`}>{p.title}</a>
						</h2>

						<p class="card-blurb">{p.blurb}</p>

						<ul class="cats" aria-label="Categories">
							{p.categories.map((c) => (
								<li>{c}</li>
							))}
						</ul>

						<ul class="tag-list" aria-label="Stack">
							{p.tags.map((t) => (
								<li>{t}</li>
							))}
						</ul>

						<footer class="card-foot">
							<span class="lang">
								<span
									class="lang-dot"
									style={`background:${langColor[p.language] ?? 'var(--pp)'}`}
									aria-hidden="true"
								/>
								{p.language}
							</span>
							<span class="year">{p.year}</span>
						</footer>

						<div class="card-links">
							<a class="link" href={`/projects/${p.slug}`}>
								Read more
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
									<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round" />
								</svg>
							</a>
							{!p.noRepo && (
							<a class="link" href={repoUrl(p.slug)} target="_blank" rel="noopener noreferrer">
								Code
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
									<path d="M7 17 17 7M9 7h8v8" stroke-width="2" stroke-linecap="round" />
								</svg>
							</a>
							)}
							{p.demoUrl && (
								<a class="link" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
									Live
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>

		<div class="empty" id="empty-state" hidden>
			<p class="empty-title">No projects match that.</p>
			<p class="empty-sub">Try a different keyword, or reset the filters.</p>
			<button id="reset-filters" type="button" class="ghost-btn">Reset filters</button>
		</div>

		<div class="more-row">
			<a
				class="ghost-btn"
				href={`https://github.com/${GITHUB_USER}?tab=repositories`}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="gh-mark" aria-hidden="true"></span>
				Browse everything on GitHub
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</a>
		</div>
	</div>
</Layout>

<script>
	/**
	 * Client-side filter: category (single-select pills) AND free-text search.
	 * Runs on first paint and on every client-side navigation into this page.
	 */
	function initProjectFilter() {
		const grid = document.getElementById('project-grid');
		if (!grid) return;
		// Guard against double-binding when the view-transition router re-runs scripts.
		if ((grid as any).__filterBound) return;
		(grid as any).__filterBound = true;

		const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
		const search = document.getElementById('project-search') as HTMLInputElement | null;
		const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
		const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill'));
		const countEl = document.getElementById('result-count');
		const emptyState = document.getElementById('empty-state');
		const resetBtn = document.getElementById('reset-filters');

		// Keep the flow spacer exactly as tall as the fixed toolbar, so cards never
		// hide behind it — recomputed on resize because the pills wrap.
		const toolbar = document.querySelector<HTMLElement>('.toolbar');
		const spacer = document.getElementById('toolbar-spacer');
		function sizeSpacer() {
			if (toolbar && spacer) spacer.style.height = `${toolbar.offsetHeight}px`;
		}
		sizeSpacer();
		window.addEventListener('resize', sizeSpacer);
		if ((document as any).fonts?.ready) (document as any).fonts.ready.then(sizeSpacer);

		let activeCat = 'all';
		let query = '';

		function apply() {
			const q = query.trim().toLowerCase();
			let shown = 0;

			for (const card of cards) {
				const cats = (card.dataset.categories ?? '').split('|');
				const hay = card.dataset.haystack ?? '';
				const matchCat = activeCat === 'all' || cats.includes(activeCat);
				const matchText = q === '' || hay.includes(q);
				const visible = matchCat && matchText;
				card.hidden = !visible;
				if (visible) shown++;
			}

			if (countEl) countEl.textContent = String(shown);
			if (emptyState) emptyState.hidden = shown !== 0;
			if (grid) grid.hidden = shown === 0;
			if (clearBtn) clearBtn.hidden = q === '';
		}

		search?.addEventListener('input', () => {
			query = search.value;
			apply();
		});

		clearBtn?.addEventListener('click', () => {
			if (search) search.value = '';
			query = '';
			search?.focus();
			apply();
		});

		for (const pill of pills) {
			pill.addEventListener('click', () => {
				for (const p of pills) {
					p.classList.remove('active');
					p.setAttribute('aria-pressed', 'false');
				}
				pill.classList.add('active');
				pill.setAttribute('aria-pressed', 'true');
				activeCat = pill.dataset.cat ?? 'all';
				apply();
			});
		}

		resetBtn?.addEventListener('click', () => {
			activeCat = 'all';
			query = '';
			if (search) search.value = '';
			for (const p of pills) {
				const isAll = p.dataset.cat === 'all';
				p.classList.toggle('active', isAll);
				p.setAttribute('aria-pressed', String(isAll));
			}
			apply();
		});

		apply();
	}

	document.addEventListener('astro:page-load', initProjectFilter);
	if (document.readyState !== 'loading') initProjectFilter();
	else document.addEventListener('DOMContentLoaded', initProjectFilter);
</script>


<style>
	/* The toolbar is sticky (in flow) now, so the old fixed-toolbar spacer is not
	   needed; the script still sizes it, harmlessly. */
	#toolbar-spacer {
		display: none;
	}

	/* ---------- Sticky toolbar ---------- */
	.toolbar {
		position: sticky;
		top: calc(var(--header-h) + 10px);
		z-index: 20;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 0.9rem;
		margin-bottom: 1rem;
		background: var(--sheet);
		border: 1.5px solid var(--line-strong);
		box-shadow: 4px 4px 0 var(--hard);
	}

	.search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0 0.4rem 0 0.85rem;
		border: 1.5px solid var(--line);
		background: var(--card);
		transition: border-color 0.25s var(--ease);
	}

	.search:focus-within {
		border-color: var(--red);
	}

	.search-icon {
		width: 18px;
		height: 18px;
		color: var(--muted);
		flex-shrink: 0;
	}

	#project-search {
		flex: 1;
		min-width: 0;
		border: none;
		background: transparent;
		color: var(--fg);
		font-family: var(--f-mono);
		font-size: 0.9rem;
		padding: 0.75rem 0;
		outline: none;
	}

	#project-search::placeholder {
		color: var(--muted);
	}

	#project-search::-webkit-search-decoration,
	#project-search::-webkit-search-cancel-button {
		-webkit-appearance: none;
		appearance: none;
	}

	.search-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		border: none;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition:
			background-color 0.2s var(--ease),
			color 0.2s var(--ease);
	}

	.search-clear:hover {
		background: var(--red);
		color: #fff;
	}

	.search-clear svg {
		width: 15px;
		height: 15px;
	}

	/* Category filters: outline chips; the active one is solid, like the nav. */
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.42rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font-family: var(--f-mono);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		cursor: pointer;
		white-space: nowrap;
		transition:
			color 0.3s var(--ease),
			background-color 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}

	.pill:hover {
		color: var(--fg);
		border-color: var(--line-strong);
	}

	.pill.active {
		color: var(--bg);
		background: var(--fg);
		border-color: var(--fg);
	}

	.pill .count {
		font-family: var(--f-dot);
		font-size: 0.85rem;
		font-weight: 900;
		letter-spacing: 0;
	}

	.pill.active .count {
		color: var(--red);
	}

	.result-line {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		margin: 0 0 1rem;
		font-family: var(--f-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	#result-count {
		font-size: 1.3rem;
		color: var(--fg);
		letter-spacing: 0;
	}

	/* ---------- Joined listing grid ---------- */
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1.5px solid var(--line-strong);
		border-left: 1.5px solid var(--line-strong);
		counter-reset: item;
	}

	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.card {
		counter-increment: item;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: clamp(1.1rem, 2.4vw, 1.4rem);
		background: var(--card);
		border-right: 1.5px solid var(--line-strong);
		border-bottom: 1.5px solid var(--line-strong);
		transition: background-color 0.35s var(--ease);
	}

	.card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--red);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s var(--ease);
	}

	.card:hover {
		background: var(--card-2);
	}

	.card:hover::before {
		transform: scaleX(1);
	}

	/* Screenshot: silver-toned at rest, full colour on hover. */
	.card-shot {
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1.5px solid var(--line-strong);
		background: var(--sheet);
	}

	.card-shot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		filter: grayscale(1) contrast(1.05);
		transition:
			filter 0.5s var(--ease),
			transform 0.7s var(--ease);
	}

	.card:hover .card-shot img {
		filter: none;
		transform: scale(1.035);
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	/* Counter skips hidden cards, so the visible listings always renumber 01…n. */
	.card-no::before {
		content: counter(item, decimal-leading-zero);
	}

	.card-no {
		font-size: 1.5rem;
		line-height: 1;
	}

	.repo-mark {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		background-color: var(--muted);
		-webkit-mask: url('/icons/github.svg') center / contain no-repeat;
		mask: url('/icons/github.svg') center / contain no-repeat;
		transition: background-color 0.3s var(--ease);
	}

	.card:hover .repo-mark {
		background-color: var(--red-text);
	}

	.status {
		font-family: var(--f-mono);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 0.18rem 0.45rem;
		border: 1.5px solid var(--red);
		color: var(--red-text);
		transform: rotate(-3deg);
	}

	.featured-dot {
		margin-left: auto;
		color: var(--red-text);
		font-size: 0.95rem;
		line-height: 1;
	}

	.card-title {
		margin: 0.2rem 0 0;
		font-family: var(--f-head);
		font-weight: 700;
		font-size: 1.22rem;
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.card-title a {
		text-decoration: none;
	}

	.card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card-blurb {
		margin: 0;
		flex-grow: 1;
		font-size: 0.97rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.cats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.8rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cats li {
		font-family: var(--f-mono);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--red-text);
	}

	.card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 0.65rem;
		border-top: 1px dashed var(--line);
		font-family: var(--f-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.lang {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.lang-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}

	.year {
		font-family: var(--f-dot);
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--fg);
		letter-spacing: 0;
	}

	.card-links {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 1.1rem;
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--f-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--red-text);
	}

	.link svg {
		width: 12px;
		height: 12px;
	}

	.link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ---------- Empty state ---------- */
	.empty {
		text-align: center;
		padding: clamp(2.5rem, 8vw, 4.5rem) 1rem;
		border: 2px dashed var(--line-strong);
	}

	.empty-title {
		margin: 0 0 0.4rem;
		font-family: var(--f-dot);
		font-weight: 900;
		font-size: clamp(1.6rem, 4vw, 2.4rem);
		text-transform: uppercase;
	}

	.empty-sub {
		margin: 0 0 1.25rem;
		font-style: italic;
		color: var(--muted);
	}

	/* Native [hidden] is display:none, but these set an explicit display that
	   would otherwise win — restore hiding so filtering actually hides. */
	.card[hidden],
	.grid[hidden],
	.search-clear[hidden],
	#empty-state[hidden] {
		display: none !important;
	}

	@media (max-width: 640px) {
		.toolbar {
			top: calc(var(--header-h) + 6px);
			padding: 0.7rem;
			box-shadow: 3px 3px 0 var(--hard);
		}
		.pills {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			margin-inline: -0.7rem;
			padding-inline: 0.7rem;
		}
		.pills::-webkit-scrollbar {
			display: none;
		}
	}
</style>
