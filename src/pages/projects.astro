---
/**
 * Projects gallery.
 *
 * A glassmorphism toolbar (search box + category pills) filters a grid of glass
 * project cards entirely client-side — no round-trips, so filtering is instant and
 * works on the static deploy. Data comes from `src/data/projects.ts`; the pill set
 * is the subset of CATEGORY_ORDER actually used by at least one project, so no pill
 * ever shows zero results on load.
 *
 * Progressive enhancement: with JS off, every card is simply visible. The script
 * only ever hides cards, never creates them.
 */
import Layout from '../layouts/Layout.astro';
import { projects, GITHUB_USER, CATEGORY_ORDER } from '../data/projects';

const repoUrl = (slug: string) => `https://github.com/${GITHUB_USER}/${slug}`;

// Sort: featured first, then newest, then alphabetical — a deterministic order that
// puts the strongest work up top on first paint.
const sorted = [...projects].sort((a, b) => {
	if (Boolean(b.featured) !== Boolean(a.featured)) return a.featured ? -1 : 1;
	if (b.year !== a.year) return b.year - a.year;
	return a.title.localeCompare(b.title);
});

// Only show pills for categories that at least one project actually uses.
const used = new Set(projects.flatMap((p) => p.categories));
const categories = CATEGORY_ORDER.filter((c) => used.has(c));

const counts = Object.fromEntries(
	categories.map((c) => [c, projects.filter((p) => p.categories.includes(c)).length])
);

// A small language → dot-colour map so the footer dot reads at a glance.
const langColor: Record<string, string> = {
	TypeScript: '#3178c6',
	JavaScript: '#f1e05a',
	Python: '#3572a5',
	'Jupyter Notebook': '#da5b0b',
	HTML: '#e34c26',
	CSS: '#563d7c',
	Shell: '#89e051',
	Astro: '#ff5a03',
};
---

<Layout
	title="Projects"
	description="Machine learning, computer vision, LLM, and cybersecurity projects built by Gabriel John Solomon — filter the full gallery by category or search."
>
	<div class="projects-page">
		<!-- Glassmorphism filter toolbar -->
		<div class="toolbar" role="search">
			<div class="search">
				<svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"
					stroke="currentColor">
					<circle cx="11" cy="11" r="7" stroke-width="2"></circle>
					<path d="m21 21-4.3-4.3" stroke-width="2" stroke-linecap="round"></path>
				</svg>
				<input
					id="project-search"
					type="search"
					placeholder="Search projects, stacks, keywords…"
					autocomplete="off"
					aria-label="Search projects"
				/>
				<button id="search-clear" type="button" class="search-clear" aria-label="Clear search" hidden>
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
						<path d="M18 6 6 18M6 6l12 12" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<div class="pills" role="group" aria-label="Filter by category">
				<button class="pill active" type="button" data-cat="all" aria-pressed="true">
					All <span class="count">{projects.length}</span>
				</button>
				{
					categories.map((c) => (
						<button class="pill" type="button" data-cat={c} aria-pressed="false">
							{c} <span class="count">{counts[c]}</span>
						</button>
					))
				}
			</div>
		</div>

		<!-- Reserves the fixed toolbar's vertical space in normal flow; its height is
		     set in JS so wrapping pills never hide the cards behind the bar. -->
		<div id="toolbar-spacer" aria-hidden="true"></div>

		<p class="result-line" aria-live="polite">
			Showing <span id="result-count">{sorted.length}</span> of {projects.length} projects
		</p>

		<div class="grid" id="project-grid">
			{
				sorted.map((p) => (
					<article
						class="card"
						data-categories={p.categories.join('|')}
						data-haystack={`${p.title} ${p.blurb} ${p.tags.join(' ')} ${p.categories.join(' ')} ${p.language}`.toLowerCase()}
					>
						<div class="card-sheen" aria-hidden="true" />

						<div class="card-head">
							<span class="repo-mark" aria-hidden="true" />
							{p.status && <span class="status">{p.status}</span>}
							{p.featured && <span class="featured-dot" title="Featured">★</span>}
						</div>

						<h2 class="card-title">
							<a href={repoUrl(p.slug)} target="_blank" rel="noopener noreferrer">
								{p.title}
							</a>
						</h2>

						<p class="card-blurb">{p.blurb}</p>

						<ul class="cats" aria-label="Categories">
							{p.categories.map((c) => (
								<li>{c}</li>
							))}
						</ul>

						<ul class="tags" aria-label="Stack">
							{p.tags.map((t) => (
								<li>{t}</li>
							))}
						</ul>

						<footer class="card-foot">
							<span class="lang">
								<span
									class="lang-dot"
									style={`background:${langColor[p.language] ?? 'var(--pp)'}`}
									aria-hidden="true"
								/>
								{p.language}
							</span>
							<span class="year">{p.year}</span>
						</footer>

						<div class="card-links">
							<a class="link" href={repoUrl(p.slug)} target="_blank" rel="noopener noreferrer">
								Code
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
									<path d="M7 17 17 7M9 7h8v8" stroke-width="2" stroke-linecap="round" />
								</svg>
							</a>
							{p.demoUrl && (
								<a class="link" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
									Live
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>

		<div class="empty" id="empty-state" hidden>
			<p class="empty-title">No projects match that.</p>
			<p class="empty-sub">Try a different keyword, or reset the filters.</p>
			<button id="reset-filters" type="button" class="ghost-btn">Reset filters</button>
		</div>

		<div class="all-repos">
			<a
				class="ghost-btn"
				href={`https://github.com/${GITHUB_USER}?tab=repositories`}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="gh-mark" aria-hidden="true"></span>
				Browse everything on GitHub
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</a>
		</div>
	</div>
</Layout>

<script>
	/**
	 * Client-side filter: category (single-select pills) AND free-text search.
	 * Runs on first paint and on every client-side navigation into this page.
	 */
	function initProjectFilter() {
		const grid = document.getElementById('project-grid');
		if (!grid) return;
		// Guard against double-binding when the view-transition router re-runs scripts.
		if ((grid as any).__filterBound) return;
		(grid as any).__filterBound = true;

		const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
		const search = document.getElementById('project-search') as HTMLInputElement | null;
		const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
		const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill'));
		const countEl = document.getElementById('result-count');
		const emptyState = document.getElementById('empty-state');
		const resetBtn = document.getElementById('reset-filters');

		// Keep the flow spacer exactly as tall as the fixed toolbar, so cards never
		// hide behind it — recomputed on resize because the pills wrap.
		const toolbar = document.querySelector<HTMLElement>('.toolbar');
		const spacer = document.getElementById('toolbar-spacer');
		function sizeSpacer() {
			if (toolbar && spacer) spacer.style.height = `${toolbar.offsetHeight}px`;
		}
		sizeSpacer();
		window.addEventListener('resize', sizeSpacer);
		if ((document as any).fonts?.ready) (document as any).fonts.ready.then(sizeSpacer);

		let activeCat = 'all';
		let query = '';

		function apply() {
			const q = query.trim().toLowerCase();
			let shown = 0;

			for (const card of cards) {
				const cats = (card.dataset.categories ?? '').split('|');
				const hay = card.dataset.haystack ?? '';
				const matchCat = activeCat === 'all' || cats.includes(activeCat);
				const matchText = q === '' || hay.includes(q);
				const visible = matchCat && matchText;
				card.hidden = !visible;
				if (visible) shown++;
			}

			if (countEl) countEl.textContent = String(shown);
			if (emptyState) emptyState.hidden = shown !== 0;
			grid.hidden = shown === 0;
			if (clearBtn) clearBtn.hidden = q === '';
		}

		search?.addEventListener('input', () => {
			query = search.value;
			apply();
		});

		clearBtn?.addEventListener('click', () => {
			if (search) search.value = '';
			query = '';
			search?.focus();
			apply();
		});

		for (const pill of pills) {
			pill.addEventListener('click', () => {
				for (const p of pills) {
					p.classList.remove('active');
					p.setAttribute('aria-pressed', 'false');
				}
				pill.classList.add('active');
				pill.setAttribute('aria-pressed', 'true');
				activeCat = pill.dataset.cat ?? 'all';
				apply();
			});
		}

		resetBtn?.addEventListener('click', () => {
			activeCat = 'all';
			query = '';
			if (search) search.value = '';
			for (const p of pills) {
				const isAll = p.dataset.cat === 'all';
				p.classList.toggle('active', isAll);
				p.setAttribute('aria-pressed', String(isAll));
			}
			apply();
		});

		apply();
	}

	document.addEventListener('astro:page-load', initProjectFilter);
	if (document.readyState !== 'loading') initProjectFilter();
	else document.addEventListener('DOMContentLoaded', initProjectFilter);
</script>

<style>
	.projects-page {
		/* Distance from the viewport top at which the fixed toolbar is pinned, and
		   the matching flow offset so the spacer lines up with it. */
		--toolbar-top: 90px;
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-top: var(--toolbar-top);
		padding-bottom: clamp(3.5rem, 9vw, 6rem);
		box-sizing: border-box;
	}

	/* Reserves the fixed toolbar's height in normal flow (set in JS). */
	#toolbar-spacer {
		width: 100%;
		margin-bottom: 1.1rem;
	}

	/* ---- Glassmorphism toolbar (fixed to the top, under the dock) ---- */
	.toolbar {
		position: fixed;
		top: var(--toolbar-top);
		left: 0;
		right: 0;
		margin-inline: auto;
		/* Match the centred content column width (page max-width minus its gutters),
		   clamped to the viewport so it never overflows on narrow screens. */
		width: min(
			calc(100% - 2 * var(--gutter)),
			calc(var(--content-width) - 2 * var(--gutter))
		);
		box-sizing: border-box;
		z-index: 20;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: clamp(0.9rem, 2.5vw, 1.3rem);
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--surface);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		box-shadow:
			0 8px 32px rgb(0 0 0 / 0.28),
			inset 0 1px 0 rgb(255 255 255 / 0.08);
	}

	.search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.1rem 0.5rem 0.1rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--chip-bg);
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.search:focus-within {
		border-color: var(--pp);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--pp) 22%, transparent);
	}

	.search-icon {
		width: 18px;
		height: 18px;
		color: var(--muted);
		flex-shrink: 0;
	}

	#project-search {
		flex: 1;
		min-width: 0;
		border: none;
		background: transparent;
		color: var(--text-color);
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.95rem;
		padding: 0.7rem 0;
		outline: none;
	}

	#project-search::placeholder {
		color: var(--muted);
	}

	/* Hide the native clear/search decorations so our own button is the only one. */
	#project-search::-webkit-search-decoration,
	#project-search::-webkit-search-cancel-button {
		-webkit-appearance: none;
		appearance: none;
	}

	.search-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.search-clear:hover {
		background: var(--surface-hover);
		color: var(--text-color);
	}

	.search-clear svg {
		width: 15px;
		height: 15px;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.42rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--chip-bg);
		color: var(--muted);
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.8rem;
		cursor: pointer;
		white-space: nowrap;
		transition:
			color 0.25s ease,
			border-color 0.25s ease,
			background 0.25s ease,
			transform 0.2s ease;
	}

	.pill:hover {
		color: var(--text-color);
		border-color: var(--pp);
		transform: translateY(-1px);
	}

	.pill.active {
		color: var(--opp);
		background: var(--pp);
		border-color: var(--pp);
		font-family: 'pop-bold', system-ui, sans-serif;
	}

	.pill .count {
		font-size: 0.68rem;
		opacity: 0.75;
	}

	.result-line {
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.8rem;
		color: var(--muted);
		margin: 0 0 1.1rem;
		padding-left: 0.25rem;
	}

	/* ---- Grid & cards ---- */
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.3rem);
	}

	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.25rem;
		height: 100%;
		box-sizing: border-box;
		overflow: hidden;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--surface);
		backdrop-filter: blur(14px) saturate(130%);
		-webkit-backdrop-filter: blur(14px) saturate(130%);
		box-shadow:
			0 8px 28px rgb(0 0 0 / 0.22),
			inset 0 1px 0 rgb(255 255 255 / 0.06);
		transition:
			transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			background 0.3s ease;
	}

	.card:hover {
		transform: translateY(-5px);
		border-color: var(--pp);
		background: var(--surface-hover);
		box-shadow: 0 18px 40px rgb(0 0 0 / 0.32);
	}

	/* Diagonal glass sheen that drifts across on hover. */
	.card-sheen {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			120deg,
			transparent 30%,
			color-mix(in srgb, var(--pp) 14%, transparent) 50%,
			transparent 70%
		);
		opacity: 0;
		transform: translateX(-30%);
		transition: opacity 0.4s ease, transform 0.6s ease;
	}

	.card:hover .card-sheen {
		opacity: 1;
		transform: translateX(30%);
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.repo-mark {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		background-color: var(--muted);
		mask: url('/icons/github.svg') center / contain no-repeat;
		-webkit-mask: url('/icons/github.svg') center / contain no-repeat;
		transition: background-color 0.3s ease;
	}

	.card:hover .repo-mark {
		background-color: var(--pp);
	}

	.status {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		color: var(--pp);
		background: color-mix(in srgb, var(--pp) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--pp) 35%, transparent);
	}

	.featured-dot {
		margin-left: auto;
		color: var(--pp);
		font-size: 0.9rem;
		line-height: 1;
	}

	.card-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 1.02rem;
		line-height: 1.3;
		margin: 0;
	}

	.card-title a {
		color: inherit;
		text-decoration: none;
	}

	/* Stretched hit area makes the whole card open the repo. */
	.card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius);
	}

	.card:hover .card-title a {
		color: var(--pp);
	}

	.card-blurb {
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		flex-grow: 1;
	}

	.cats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cats li {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 0.62rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.2rem 0.5rem;
		border-radius: 6px;
		color: var(--pp);
		background: color-mix(in srgb, var(--pp) 10%, transparent);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tags li {
		font-size: 0.68rem;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		background: var(--chip-bg);
		border: 1px solid var(--border);
		color: var(--text-color);
		white-space: nowrap;
	}

	.card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.72rem;
		color: var(--muted);
		padding-top: 0.15rem;
	}

	.lang {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.lang-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		display: inline-block;
	}

	.card-links {
		display: flex;
		gap: 1rem;
		position: relative;
		z-index: 1;
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--pp);
		text-decoration: none;
	}

	.link svg {
		width: 13px;
		height: 13px;
	}

	.link:hover {
		text-decoration: underline;
	}

	/* ---- Empty state ---- */
	.empty {
		text-align: center;
		padding: clamp(2.5rem, 8vw, 4.5rem) 1rem;
	}

	.empty-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 1.2rem;
		margin: 0 0 0.4rem;
	}

	.empty-sub {
		font-family: 'pop-thin', system-ui, sans-serif;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}

	/* ---- Shared ghost button ---- */
	.all-repos {
		display: flex;
		justify-content: center;
		margin-top: clamp(2rem, 5vw, 3rem);
	}

	.ghost-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.7rem 1.35rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-color);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition:
			border-color 0.3s ease,
			color 0.3s ease,
			transform 0.3s ease,
			background 0.3s ease;
	}

	.ghost-btn:hover {
		border-color: var(--pp);
		color: var(--pp);
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	.gh-mark {
		width: 17px;
		height: 17px;
		background-color: currentColor;
		mask: url('/icons/github.svg') center / contain no-repeat;
		-webkit-mask: url('/icons/github.svg') center / contain no-repeat;
	}

	.ghost-btn svg {
		width: 15px;
		height: 15px;
	}

	@media (max-width: 640px) {
		.projects-page {
			--toolbar-top: 74px;
		}
	}

	/* Native [hidden] is display:none, but .card/.grid/.search-clear set an explicit
	   display that would otherwise win — restore hiding so filtering actually hides. */
	.card[hidden],
	.grid[hidden],
	.search-clear[hidden],
	#empty-state[hidden] {
		display: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.repo-mark,
		.card-sheen,
		.pill,
		.ghost-btn {
			transition: none;
		}
		.card:hover {
			transform: none;
		}
		.card:hover .card-sheen {
			transform: none;
		}
