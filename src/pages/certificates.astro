---
/**
 * Full certificates gallery — every certificate, seminar and badge, grouped by
 * category. Replaces the old /resume page; the resume itself is the downloadable
 * PDF linked from the home hero.
 */
import Layout from '../layouts/Layout.astro';
import CertCard from '../components/CertCard.astro';
import {
	certifications,
	CATEGORY_ORDER,
	CATEGORY_LABEL,
	LINKEDIN_URL,
} from '../data/certifications';

const groups = CATEGORY_ORDER.map((cat) => ({
	label: CATEGORY_LABEL[cat],
	items: certifications.filter((c) => c.category === cat),
})).filter((g) => g.items.length > 0);
---

<Layout
	title="Certificates"
	description="Every certificate, seminar and badge earned by Gabriel John Solomon — certifications, seminars and participation, grouped and viewable in full."
>
	<div class="certs-page">
		<header class="page-head">
			<p class="eyebrow">Credentials</p>
			<h1 class="page-title">Certificates & training</h1>
		</header>

		{
			groups.map((group) => (
				<section class="group">
					<div class="group-head">
						<h2 class="group-title">{group.label}</h2>
						<span class="group-count">{group.items.length}</span>
					</div>
					<div class="grid">
						{group.items.map((cert) => (
							<CertCard cert={cert} />
						))}
					</div>
				</section>
			))
		}

		<a class="linkedin-panel" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
			<span class="li-mark" aria-hidden="true"></span>
			<span class="li-copy">
				<strong class="li-title">See every credential on LinkedIn</strong>
				<span class="li-sub">linkedin.com/in/gabrieljohnsolomon</span>
			</span>
			<svg class="li-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
				<path d="M7 17 17 7M9 7h8v8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
				></path>
			</svg>
		</a>
	</div>
</Layout>

<style>
	.certs-page {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-top: clamp(5.5rem, 12vw, 8rem);
		padding-bottom: clamp(3.5rem, 9vw, 6rem);
		box-sizing: border-box;
	}

	.page-head {
		text-align: center;
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.eyebrow {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--pp);
		margin: 0 0 0.6rem;
	}

	.page-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(2rem, 6vw, 3.1rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.group {
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.group-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: clamp(0.9rem, 2.5vw, 1.25rem);
	}

	.group-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(1rem, 2.6vw, 1.25rem);
		margin: 0;
	}

	.group-count {
		display: inline-grid;
		place-items: center;
		min-width: 1.4rem;
		height: 1.4rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-family: 'pop-bold', system-ui, sans-serif;
		color: var(--pp);
		background: color-mix(in srgb, var(--pp) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--pp) 30%, transparent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ---------- LinkedIn panel ---------- */
	.linkedin-panel {
		display: flex;
		align-items: center;
		gap: clamp(0.9rem, 2.5vw, 1.25rem);
		max-width: 34rem;
		margin-inline: auto;
		margin-top: clamp(1rem, 3vw, 1.5rem);
		padding: clamp(1.1rem, 3vw, 1.5rem) clamp(1.1rem, 3vw, 1.6rem);
		border-radius: var(--radius-lg);
		background: var(--surface);
		border: 1px solid var(--border);
		text-decoration: none;
		color: var(--text-color);
		transition:
			transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
			border-color 0.3s ease,
			background 0.3s ease,
			box-shadow 0.3s ease;
	}

	.linkedin-panel:hover {
		transform: translateY(-3px);
		border-color: #0a66c2;
		background: var(--surface-hover);
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
	}

	.li-mark {
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		background-color: #0a66c2;
		mask: url('/icons/linkedin.svg') center / contain no-repeat;
		-webkit-mask: url('/icons/linkedin.svg') center / contain no-repeat;
	}

	.li-copy {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.li-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(0.9rem, 2.4vw, 1rem);
		line-height: 1.35;
		font-weight: 700;
	}

	.li-sub {
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.78rem;
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	.li-arrow {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		margin-left: auto;
		color: var(--muted);
		transition:
			transform 0.3s ease,
			color 0.3s ease;
	}

	.linkedin-panel:hover .li-arrow {
		color: #0a66c2;
		transform: translate(2px, -2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.linkedin-panel,
		.li-arrow {
			transition: none;
		}
		.linkedin-panel:hover,
		.linkedin-panel:hover .li-arrow {
			transform: none;
		}
	}
</style>
