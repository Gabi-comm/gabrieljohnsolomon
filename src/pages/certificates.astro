---
/**
 * Full certificates gallery — every certificate, seminar and badge, grouped by
 * category as clippings. The resume itself is the PDF linked from the home hero.
 */
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CertCard from '../components/CertCard.astro';
import { certifications, CATEGORY_ORDER, CATEGORY_LABEL, LINKEDIN_URL } from '../data/certifications';

const groups = CATEGORY_ORDER.map((cat) => ({
	label: CATEGORY_LABEL[cat],
	items: certifications.filter((c) => c.category === cat),
})).filter((g) => g.items.length > 0);
---

<Layout
	title="Certificates"
	description="Every certificate, seminar and badge earned by Gabriel John Solomon — certifications, seminars and participation, grouped and viewable in full."
>
	<div class="page">
		<PageHead
			title="Clippings"
		/>

		{
			groups.map((group, i) => (
				<section class="group">
					<h2 class="group-head reveal">
						<span class="g-no dot-type">{String.fromCharCode(65 + i)}</span>
						<span class="g-title">{group.label}</span>
						<span class="g-fill" aria-hidden="true" />
						<span class="g-count dot-type">{String(group.items.length).padStart(2, '0')}</span>
					</h2>
					<div class="grid">
						{group.items.map((cert) => (
							<CertCard cert={cert} />
						))}
					</div>
				</section>
			))
		}

		<a class="classified reveal" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
			<span class="cl-tag">Notice</span>
			<span class="li-mark" aria-hidden="true"></span>
			<span class="cl-copy">
				<strong>See every credential on LinkedIn</strong>
				<span>linkedin.com/in/gabrieljohnsolomon</span>
			</span>
			<span class="cl-arrow" aria-hidden="true">↗</span>
		</a>
	</div>
</Layout>

<style>
	.group {
		margin-bottom: clamp(2.5rem, 6vw, 3.75rem);
	}

	.group-head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin: 0 0 clamp(1rem, 2.6vw, 1.5rem);
	}

	.g-no {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		background: var(--fg);
		color: var(--bg);
		font-size: 1.2rem;
	}

	.g-title {
		font-family: var(--f-head);
		font-weight: 700;
		font-size: clamp(1.3rem, 3vw, 1.8rem);
		letter-spacing: -0.03em;
	}

	.g-fill {
		flex: 1;
		height: 1.5px;
		background: var(--line-strong);
	}

	.g-count {
		font-size: 1.4rem;
		color: var(--red-text);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.4vw, 1.6rem);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ---------- Classified ad ---------- */
	.classified {
		--shadow: var(--hard);
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.1rem;
		max-width: 36rem;
		margin: clamp(1rem, 3vw, 1.5rem) auto 0;
		padding: 1.4rem 1.5rem;
		border: 2px dashed var(--line-strong);
		background: var(--card);
		text-decoration: none;
		color: var(--fg);
		box-shadow: 0 0 0 var(--shadow);
		transition:
			transform 0.35s var(--ease),
			box-shadow 0.35s var(--ease),
			border-style 0.35s;
	}

	.classified:hover {
		border-style: solid;
		transform: translate(-4px, -4px);
		box-shadow: 4px 4px 0 var(--shadow);
	}

	.cl-tag {
		position: absolute;
		top: -0.7rem;
		left: 1rem;
		padding: 0.15rem 0.5rem;
		background: var(--red);
		color: #fff;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.li-mark {
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		background-color: var(--fg);
		-webkit-mask: url('/icons/linkedin.svg') center / contain no-repeat;
		mask: url('/icons/linkedin.svg') center / contain no-repeat;
	}

	.cl-copy {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.cl-copy strong {
		font-family: var(--f-head);
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.cl-copy span {
		font-family: var(--f-mono);
		font-size: 0.7rem;
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	.cl-arrow {
		margin-left: auto;
		font-family: var(--f-mono);
		font-size: 1.2rem;
		transition:
			transform 0.3s var(--ease),
			color 0.3s var(--ease);
	}

	.classified:hover .cl-arrow {
		color: var(--red-text);
		transform: translate(3px, -3px);
	}
</style>
