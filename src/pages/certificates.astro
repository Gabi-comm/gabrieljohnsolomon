---
/**
 * Full certificates gallery — every certificate, seminar and badge, grouped by
 * category as clippings. The resume itself is the PDF linked from the home hero.
 */
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CertCard from '../components/CertCard.astro';
import { certifications, CATEGORY_ORDER, CATEGORY_LABEL } from '../data/certifications';

const groups = CATEGORY_ORDER.map((cat) => ({
	label: CATEGORY_LABEL[cat],
	items: certifications.filter((c) => c.category === cat),
})).filter((g) => g.items.length > 0);
---

<Layout
	title="Certificates"
	description="Every certificate, seminar and badge earned by Gabriel John Solomon — certifications, seminars and participation, grouped and viewable in full."
>
	<div class="page">
		<PageHead
			title="Clippings"
		/>

		{
			groups.map((group, i) => (
				<section class="group">
					<h2 class="group-head reveal">
						<span class="g-no dot-type">{String.fromCharCode(65 + i)}</span>
						<span class="g-title">{group.label}</span>
						<span class="g-fill" aria-hidden="true" />
						<span class="g-count dot-type">{String(group.items.length).padStart(2, '0')}</span>
					</h2>
					<div class="grid">
						{group.items.map((cert) => (
							<CertCard cert={cert} />
						))}
					</div>
				</section>
			))
		}

	</div>
</Layout>

<style>
	.group {
		margin-bottom: clamp(2.5rem, 6vw, 3.75rem);
	}

	.group:last-child {
		margin-bottom: 0;
	}

	.group-head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin: 0 0 clamp(1rem, 2.6vw, 1.5rem);
	}

	.g-no {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		background: var(--fg);
		color: var(--bg);
		font-size: 1.2rem;
	}

	.g-title {
		font-family: var(--f-head);
		font-weight: 700;
		font-size: clamp(1.3rem, 3vw, 1.8rem);
		letter-spacing: -0.03em;
	}

	.g-fill {
		flex: 1;
		height: 1.5px;
		background: var(--line-strong);
	}

	.g-count {
		font-size: 1.4rem;
		color: var(--red-text);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.4vw, 1.6rem);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

</style>
