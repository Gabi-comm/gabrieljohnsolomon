</style>

<script>
	/**
	 * Dot-matrix counters tick up from zero the first time they scroll into view.
	 * The real number is in the HTML, so no-JS and reduced-motion visitors simply
	 * see it; the count only runs when scroll reveals are active.
	 */
	function initCounters() {
		if (!document.documentElement.classList.contains('js-reveal')) return;
		const els = document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])');
		if (!els.length) return;

		const pad = (n: number) => String(n).padStart(2, '0');
		const run = (el: HTMLElement) => {
			const target = Number(el.dataset.count) || 0;
			const start = performance.now();
			const dur = 1100 + Math.min(target, 30) * 12;
			const step = (t: number) => {
				const p = Math.min((t - start) / dur, 1);
				el.textContent = pad(Math.round(target * (1 - Math.pow(1 - p, 4))));
				if (p < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};

		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					io.unobserve(e.target);
					run(e.target as HTMLElement);
				}
			},
			{ threshold: 0.6 }
		);

		els.forEach((el) => {
			el.dataset.counted = '';
			el.textContent = '00';
			io.observe(el);
		});
	}

	document.addEventListener('astro:page-load', initCounters);

	/** ASCII portrait hover: pointer lens, scan-and-decode on entry, HUD readout. */
	function initAscii() {
		const fig = document.querySelector<HTMLElement>('[data-ascii]');
		if (!fig || fig.dataset.bound) return;
		fig.dataset.bound = '1';
		const stage = fig.querySelector<HTMLElement>('.ascii-stage')!;
		const base = fig.querySelector<HTMLElement>('.ascii-base')!;
		const scan = fig.querySelector<HTMLElement>('.ascii-scan')!;
		const hud = fig.querySelector<HTMLElement>('[data-hud]')!;
		const art = base.textContent ?? '';
		const lines = art.split('\n');
		const cols = Number(fig.dataset.cols) || 80;
		const rows = lines.length;
		const noise = '`.:~;=+?|)]oX#%&@01';
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		const idle = hud.textContent;
		let raf = 0;

		// Rows below the bar are faint static, rows at the bar are noise, rows
		// above it have resolved back to the portrait.
		const decode = () => {
			if (still.matches || raf) return;
			const start = performance.now();
			const dur = 950;
			scan.style.opacity = '1';
			const frame = (t: number) => {
				const p = Math.min((t - start) / dur, 1);
				const edge = p * (rows + 3);
				base.textContent = lines
					.map((line, r) => {
						if (r < edge - 3) return line;
						if (r > edge) return line.replace(/\S/g, () => (Math.random() < 0.6 ? ' ' : '.'));
						return line.replace(/\S/g, () => noise[(Math.random() * noise.length) | 0]);
					})
					.join('\n');
				scan.style.transform = `translateY(${(Math.min(edge, rows) / rows) * stage.offsetHeight}px)`;
				if (p < 1) raf = requestAnimationFrame(frame);
				else {
					base.textContent = art;
					scan.style.opacity = '0';
					raf = 0;
				}
			};
			raf = requestAnimationFrame(frame);
		};

		fig.addEventListener('pointerenter', decode);
		fig.addEventListener('pointermove', (e) => {
			const b = stage.getBoundingClientRect();
			const x = e.clientX - b.left;
			const y = e.clientY - b.top;
			fig.style.setProperty('--mx', `${x}px`);
			fig.style.setProperty('--my', `${y}px`);
			const c = Math.floor((x / b.width) * cols);
			const r = Math.floor((y / b.height) * rows);
			if (c < 0 || r < 0 || c >= cols || r >= rows) return;
			const ch = lines[r]?.[c] ?? ' ';
			hud.textContent = `R${String(r + 1).padStart(2, '0')} · C${String(c + 1).padStart(2, '0')} · ${ch === ' ' ? '␣' : ch}`;
		});
		fig.addEventListener('pointerleave', () => (hud.textContent = idle));
	}

	document.addEventListener('astro:page-load', initAscii);
	if (document.readyState !== 'loading') initAscii();
	else document.addEventListener('DOMContentLoaded', initAscii);
	if (document.readyState !== 'loading') initCounters();
	else document.addEventListener('DOMContentLoaded', initCounters);
</script>
