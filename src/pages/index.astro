---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Experience from '../components/Experience.astro';
import FeaturedRepos from '../components/FeaturedRepos.astro';
import Certifications from '../components/Certifications.astro';
import TechStack from '../components/TechStack.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import { projects } from '../data/projects';
import { experiences, competitions } from '../data/experience';
import { certifications } from '../data/certifications';

const NAME_LINES = ['Gabriel', 'John', 'Solomon'];

// The index strip: live counts from the data files, each linking to its page.
const STATS = [
	{ label: 'Projects', value: projects.length, href: '/projects', note: 'Filed in the archive' },
	{ label: 'Roles', value: experiences.length, href: '/exp', note: 'Industry & leadership' },
	{ label: 'Certificates', value: certifications.length, href: '/certificates', note: 'Credentials on file' },
	{ label: 'Competitions', value: competitions.length, href: '/exp', note: 'Hackathons & contests' },
];
---

<Layout>
	<!-- ============ Hero ============ -->
	<section class="hero" aria-labelledby="hero-name">
		<div class="hero-copy">
			<h1 class="hero-name dot-type" id="hero-name" aria-label="Gabriel John Solomon">
				{
					NAME_LINES.map((line, i) => (
						<span class="line" aria-hidden="true">
							<span style={`--l:${i}`}>{line}</span>
						</span>
					))
				}
			</h1>

			<p class="hero-dek">
				An aspiring AI Engineer passionate about computer vision, AI security and
				building systems that are <em>genuinely useful</em> to the people who use them.
			</p>

			<dl class="hero-facts">
				<div>
					<dt>Desk</dt>
					<dd>AI Engineer · AI Security · Student Leader</dd>
				</div>
				<div>
					<dt>School</dt>
					<dd>BS Computer Science, University of the East – Caloocan</dd>
				</div>
			</dl>

			<div class="hero-cta">
				<a class="btn btn-red" href="/Resume-SOLOMON.pdf" download="Resume-SOLOMON.pdf">
					Get the résumé
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"
						><path d="M12 4v13m-6-6 6 6 6-6M5 20h14" stroke-width="2" stroke-linecap="square"></path></svg
					>
				</a>
				<a class="btn" href="/projects">
					Read the work
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"
						><path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="square"></path></svg
					>
				</a>
			</div>
		</div>

		<figure class="portrait">
			<div class="halftone" aria-hidden="true"></div>
			<div class="slab" aria-hidden="true">
				<span class="slab-label dot-type">G.J.S — 001</span>
			</div>
			<picture>
				<source srcset="/portrait-cutout.webp" type="image/webp" />
				<img
					class="cutout"
					src="/portrait-cutout.png"
					width="833"
					height="752"
					alt="Gabriel John Solomon at his desk in a white shirt and red tie"
					fetchpriority="high"
					decoding="async"
				/>
			</picture>
			<span class="crop tl" aria-hidden="true"></span>
			<span class="crop tr" aria-hidden="true"></span>
		</figure>
	</section>

	<!-- ============ Index strip ============ -->
	<nav class="index-strip" aria-label="At a glance">
		{
			STATS.map((st, i) => (
				<a class="stat reveal" href={st.href}>
					<span class="stat-top">
						<span class="stat-no">{String(i + 1).padStart(2, '0')}</span>
						<span class="stat-label">{st.label}</span>
						<span class="stat-arrow" aria-hidden="true">→</span>
					</span>
					<span class="stat-value dot-type" data-count={st.value}>
						{String(st.value).padStart(2, '0')}
					</span>
					<span class="stat-note">{st.note}</span>
				</a>
			))
		}
	</nav>

	<!-- ============ Profile ============ -->
	<Section
		id="about"
		num="01"
		eyebrow="Profile"
		bare
	>
		<div class="about">
			<ContributionGraph />

			<aside class="glance reveal" aria-label="At a glance">
				<p class="glance-head">At a glance</p>
				<dl>
					<div><dt>Role</dt><dd>AI Engineer, RivanAI Cybersecurity</dd></div>
					<div><dt>Study</dt><dd>BS Computer Science</dd></div>
					<div><dt>Campus</dt><dd>UE Caloocan</dd></div>
					<div><dt>Stack</dt><dd>Python · CV · LLMs</dd></div>
					<div><dt>Focus</dt><dd>AI Security</dd></div>
				</dl>
				<a class="glance-link" href="/exp">Full record <span aria-hidden="true">→</span></a>
			</aside>
		</div>
	</Section>

	<Experience />
	<FeaturedRepos />
	<Certifications />
	<TechStack />
</Layout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 0;
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: end;
	}

	.hero-copy {
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
	}

	.hero-name {
		margin: 0.8rem 0 0;
		font-size: clamp(3.4rem, 9.6vw, 8.6rem);
		font-weight: 900;
		line-height: 0.86;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	/* Each line rises out of its own mask, staggered. */
	.hero-name .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.04em;
	}

	.hero-name .line > span {
		display: inline-block;
		white-space: nowrap;
		animation: line-up 1s var(--ease) calc(var(--intro-delay, 0s) + 0.25s + var(--l) * 0.09s) both;
	}

	/* Red full stop drawn as a square dot (Doto's period glyph reads as a plus). */
	.hero-name .line:last-child > span::after {
		content: '';
		display: inline-block;
		width: 0.15em;
		height: 0.15em;
		margin-left: 0.08em;
		background: var(--red);
	}

	@keyframes line-up {
		from {
			transform: translateY(105%);
		}
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.hero-dek {
		margin: clamp(1.1rem, 2.6vw, 1.6rem) 0 0;
		max-width: 30ch;
		font-size: clamp(1.15rem, 2.3vw, 1.5rem);
		line-height: 1.35;
		animation: fade-up 0.8s var(--ease) calc(var(--intro-delay, 0s) + 0.6s) both;
	}

	.hero-dek em {
		color: var(--red-text);
	}

	.hero-facts {
		margin: clamp(1.2rem, 3vw, 1.75rem) 0 0;
		border-top: 1px solid var(--line-strong);
		animation: fade-up 0.8s var(--ease) calc(var(--intro-delay, 0s) + 0.7s) both;
	}

	.hero-facts > div {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 1rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--line);
	}

	.hero-facts dt {
		font-family: var(--f-mono);
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		padding-top: 0.2rem;
	}

	.hero-facts dd {
		margin: 0;
		font-family: var(--f-head);
		font-weight: 500;
		font-size: 0.95rem;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: clamp(1.4rem, 3vw, 2rem);
		animation: fade-up 0.8s var(--ease) calc(var(--intro-delay, 0s) + 0.8s) both;
	}

	/* ---------- Portrait ---------- */
	.portrait {
		position: relative;
		margin: 0;
		aspect-ratio: 833 / 860;
		display: flex;
		align-items: flex-end;
		isolation: isolate;
	}

	/* Silver halftone field, fading out toward the edges. */
	.halftone {
		position: absolute;
		inset: 4% -2% 10% 6%;
		z-index: -2;
		background-image: radial-gradient(circle, var(--silver-2) 1.6px, transparent 2px);
		background-size: 9px 9px;
		-webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent 100%);
		mask-image: radial-gradient(closest-side, #000 20%, transparent 100%);
		opacity: 0.55;
		animation: fade-in 1.4s var(--ease) calc(var(--intro-delay, 0s) + 0.4s) both;
	}

	/* The red slab behind the head, with a stepped brutalist notch at its foot. */
	.slab {
		position: absolute;
		z-index: -1;
		top: 0;
		left: 27%;
		width: 48%;
		height: 74%;
		background: var(--red);
		clip-path: polygon(0 0, 100% 0, 100% 100%, 78% 100%, 78% 90%, 22% 90%, 22% 100%, 0 100%);
		transform-origin: top;
		animation: slab-down 1.1s cubic-bezier(0.65, 0, 0.2, 1) calc(var(--intro-delay, 0s) + 0.15s) both;
	}

	@keyframes slab-down {
		from {
			transform: scaleY(0);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
	}

	.slab-label {
		position: absolute;
		top: 0.9rem;
		right: 0.55rem;
		writing-mode: vertical-rl;
		font-size: 0.85rem;
		color: rgb(255 255 255 / 0.85);
		letter-spacing: 0.1em;
	}

	.portrait picture {
		display: block;
		width: 100%;
	}

	.cutout {
		display: block;
		width: 100%;
		height: auto;
		animation: portrait-in 1.1s var(--ease) calc(var(--intro-delay, 0s) + 0.45s) both;
	}

	@keyframes portrait-in {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
	}

	/* Printer's crop marks at the top corners. */
	.crop {
		position: absolute;
		top: -6px;
		width: 16px;
		height: 16px;
		border-color: var(--fg);
		border-style: solid;
		border-width: 0;
		opacity: 0.6;
	}
	.crop.tl {
		left: -6px;
		border-top-width: 1.5px;
		border-left-width: 1.5px;
	}
	.crop.tr {
		right: -6px;
		border-top-width: 1.5px;
		border-right-width: 1.5px;
	}

	/* Pointer over the picture: a hard outline traces the whole silhouette.
	   Chained drop-shadows each shadow the result of the previous ones, so four
	   cardinal offsets build an even ring. The first ring is page-coloured — a
	   gap that keeps the red ring from melting into the red slab behind. Both
	   states list the same eight shadows so the filter interpolates smoothly. */
	.cutout {
		--gap: transparent;
		--ring: transparent;
		--g: 0px;
		--r: 0px;
		filter: drop-shadow(var(--g) 0 0 var(--gap)) drop-shadow(calc(var(--g) * -1) 0 0 var(--gap))
			drop-shadow(0 var(--g) 0 var(--gap)) drop-shadow(0 calc(var(--g) * -1) 0 var(--gap))
			drop-shadow(var(--r) 0 0 var(--ring)) drop-shadow(calc(var(--r) * -1) 0 0 var(--ring))
			drop-shadow(0 var(--r) 0 var(--ring)) drop-shadow(0 calc(var(--r) * -1) 0 var(--ring));
		transition: filter 0.4s var(--ease);
	}

	.portrait picture:hover .cutout {
		--gap: var(--bg);
		--ring: var(--red);
		--g: 3px;
		--r: 4px;
		/* Let the slab start collapsing before the ring lands. */
		transition-delay: 0.18s;
	}

	/* The red slab pours into the outline: it contracts toward the figure
	   (same vertex count as its resting polygon, so clip-path interpolates)
	   and fades while the ring draws on. Reverses when the pointer leaves. */
	.slab {
		transition:
			clip-path 0.55s var(--ease-io) 0.1s,
			opacity 0.45s var(--ease) 0.15s;
	}

	.portrait:has(picture:hover) .slab {
		clip-path: polygon(46% 62%, 54% 62%, 54% 100%, 54% 100%, 54% 100%, 46% 100%, 46% 100%, 46% 100%);
		opacity: 0;
		transition:
			clip-path 0.55s var(--ease-io),
			opacity 0.4s var(--ease) 0.2s;
	}

	/* Native scroll-linked parallax as the hero leaves the screen: the slab drifts
	   up faster than the portrait. No JS, compositor-only. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.portrait {
				view-timeline-name: --hero;
			}
			.slab {
				animation:
					slab-down 1.1s cubic-bezier(0.65, 0, 0.2, 1) calc(var(--intro-delay, 0s) + 0.15s) both,
					slab-par linear both;
				animation-timeline: auto, --hero;
				animation-range: normal, exit 0% exit 100%;
				animation-composition: replace, add;
			}
			.halftone {
				animation:
					fade-in 1.4s var(--ease) calc(var(--intro-delay, 0s) + 0.4s) both,
					halftone-par linear both;
				animation-timeline: auto, --hero;
				animation-range: normal, exit 0% exit 100%;
			}
		}
	}

	@keyframes slab-par {
		to {
			translate: 0 -14%;
		}
	}

	@keyframes halftone-par {
		to {
			translate: 0 -24%;
		}
	}

	/* ---------- Index strip ----------
	   Four joined hairline cells, Nothing-widget style: mono label, big
	   dot-matrix count, a quiet note. Hover inverts the cell. */
	.index-strip {
		max-width: var(--content-width);
		margin: clamp(4rem, 7vw, 5.5rem) auto 0;
		padding-inline: var(--gutter);
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.stat {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.1rem 1.25rem 1.25rem;
		border: 1px solid var(--line);
		margin-left: -1px;
		color: var(--fg);
		text-decoration: none;
		isolation: isolate;
		transition: color 0.4s var(--ease);
	}

	.stat:first-child {
		margin-left: 0;
	}

	/* Fill rises from the bottom on hover. */
	.stat::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--fg);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 0.5s var(--ease);
	}

	.stat:hover {
		color: var(--bg);
	}

	.stat:hover::before {
		transform: scaleY(1);
	}

	.stat-top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--f-mono);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.stat-no {
		color: var(--red-text);
	}

	.stat-arrow {
		margin-left: auto;
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.35s var(--ease),
			transform 0.35s var(--ease);
	}

	.stat:hover .stat-arrow {
		opacity: 1;
		transform: none;
	}

	.stat-value {
		font-size: clamp(3rem, 6vw, 4.75rem);
		line-height: 0.85;
		font-variant-numeric: tabular-nums;
	}

	.stat-note {
		font-family: var(--f-mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		color: var(--muted);
		transition: color 0.4s var(--ease);
	}

	.stat:hover .stat-note {
		color: color-mix(in srgb, var(--bg) 70%, var(--fg));
	}

	/* ---------- About ---------- */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17rem;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.glance {
		border: 1.5px solid var(--line-strong);
		background: var(--card);
		padding: 1.1rem 1.2rem 1.2rem;
		position: relative;
	}

	.glance-head {
		margin: 0 0 0.6rem;
		font-family: var(--f-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.glance dl {
		margin: 0;
	}

	.glance dl > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0;
		border-top: 1px dashed var(--line);
	}

	.glance dt {
		font-family: var(--f-mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.glance dd {
		margin: 0;
		text-align: right;
		font-family: var(--f-head);
		font-size: 0.85rem;
		font-weight: 500;
	}

	.glance-link {
		display: inline-block;
		margin-top: 0.8rem;
		font-family: var(--f-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--red-text);
	}

	.glance-link span {
		display: inline-block;
		transition: transform 0.3s var(--ease);
	}

	.glance-link:hover span {
		transform: translateX(4px);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 960px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
		}
		.portrait {
			max-width: 560px;
			width: 100%;
			justify-self: center;
			margin-bottom: 1.5rem;
		}
		.about {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.hero-facts > div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.15rem;
		}
		.hero-cta .btn {
			flex: 1 1 100%;
		}
	}

	@media (max-width: 860px) {
		.index-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.stat {
			margin-left: 0;
		}
		/* 2×2: collapse the doubled hairlines between rows and columns. */
		.stat:nth-child(even) {
			margin-left: -1px;
		}
		.stat:nth-child(n + 3) {
			margin-top: -1px;
		}
	}
</style>

<script>
	/**
	 * Dot-matrix counters tick up from zero the first time they scroll into view.
	 * The real number is in the HTML, so no-JS and reduced-motion visitors simply
	 * see it; the count only runs when scroll reveals are active.
	 */
	function initCounters() {
		if (!document.documentElement.classList.contains('js-reveal')) return;
		const els = document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])');
		if (!els.length) return;

		const pad = (n: number) => String(n).padStart(2, '0');
		const run = (el: HTMLElement) => {
			const target = Number(el.dataset.count) || 0;
			const start = performance.now();
			const dur = 1100 + Math.min(target, 30) * 12;
			const step = (t: number) => {
				const p = Math.min((t - start) / dur, 1);
				el.textContent = pad(Math.round(target * (1 - Math.pow(1 - p, 4))));
				if (p < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};

		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					io.unobserve(e.target);
					run(e.target as HTMLElement);
				}
			},
			{ threshold: 0.6 }
		);

		els.forEach((el) => {
			el.dataset.counted = '';
			el.textContent = '00';
			io.observe(el);
		});
	}

	document.addEventListener('astro:page-load', initCounters);
	if (document.readyState !== 'loading') initCounters();
	else document.addEventListener('DOMContentLoaded', initCounters);
</script>
