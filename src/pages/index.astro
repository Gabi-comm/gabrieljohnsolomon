---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro';
import FeaturedRepos from '../components/FeaturedRepos.astro';
import Certifications from '../components/Certifications.astro';
import TechStack from '../components/TechStack.astro';

const FULL_NAME = 'Gabriel John Solomon';

// Each letter gets its own span so the name can fade in one character at a time.
// Spaces become non-breaking so they don't collapse.
const NBSP = String.fromCharCode(160); // non-breaking space
const NAME_CHARS = [...FULL_NAME].map((ch) => (ch === ' ' ? NBSP : ch));
---

<Layout>
	<!-- Hero -->
	<section class="hero">
		<!-- Drifting colour wash + a glow that follows the pointer. Purely decorative. -->
		<div class="aurora" aria-hidden="true">
			<span class="blob blob-a"></span>
			<span class="blob blob-b"></span>
			<span class="pointer-glow"></span>
		</div>

		<div class="hero-inner">
			<p class="status">
				<span class="status-dot" aria-hidden="true"></span>
				BS Computer Science · University of the East – Caloocan
			</p>

			<p class="greeting">
				Hello!! I'm
				<span class="wave" aria-hidden="true">👋</span>
			</p>

			<h1 class="name" aria-label={FULL_NAME}>
				{
					NAME_CHARS.map((ch, i) => (
						<span class="ch" aria-hidden="true" style={`--i:${i}`}>
							{ch}
						</span>
					))
				}
			</h1>

			<span class="rule" aria-hidden="true"></span>

			<p class="role">Aspiring Machine Learning Engineer · Student Leader</p>

			<div class="cta-row">
				<!-- Labels are wrapped in spans so `.btn > *` lifts them above the hover
				     shine; a bare text node can't take a z-index and the sweep would
				     wash straight over it. -->
				<a class="btn btn-primary" href="/SOLOMON.pdf" download="SOLOMON.pdf">
					<span>Check out my resume</span>
				</a>

				<a class="btn btn-ghost" href="#work">
					<span>Look at my projects</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</a>
			</div>
		</div>

		<a class="scroll-cue" href="#work" aria-label="Scroll to featured work">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
				<path d="m6 9 6 6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
				></path>
			</svg>
		</a>
	</section>

	<!-- About -->
	<section class="about" id="about">
		<div class="photos">
			<!-- width/height are the files' true intrinsic sizes so the browser reserves
			     the right space (no layout shift); CSS below sets the displayed size. -->
			<img
				src="/me.jpg"
				width="956"
				height="956"
				alt="Gabriel John Solomon"
				loading="lazy"
				decoding="async"
				class="photo photo-front"
			/>
			<img
				src="/me2.jpg"
				width="583"
				height="728"
				alt="Gabriel John Solomon speaking at an event"
				loading="lazy"
				decoding="async"
				class="photo photo-back"
			/>
		</div>

		<div class="bio">
			<h2 class="bio-head">Aspiring Machine Learning Engineer · Student Leader</h2>

			<!-- Kept deliberately short: the degree, university, awards, tools and every
			     leadership role are already shown by the hero pill, the experience
			     timeline and the tech stack. This paragraph carries only what those
			     sections can't — what the work is actually for. -->
			<p>
				I build <b>intelligent systems in Python</b> — computer vision models, retrieval-augmented
				chatbots, and automation that turns messy data into something a person can actually act
				on.
			</p>

			<p>
				Most of what I know came from high-stakes rooms: national competitions, hackathons I was
				later asked to judge, and student organisations where the technical call is mine to make.
				I care less about a model that scores well than about a system someone finds genuinely
				useful.
			</p>
		</div>
	</section>

	<Experience />
	<FeaturedRepos />
	<Certifications />
	<TechStack />
</Layout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		/* Own stacking context so the aurora layers sit behind the copy but still
		   above the page's star canvas. */
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		min-height: min(92vh, 820px);
		padding: clamp(6rem, 15vh, 9rem) var(--gutter) clamp(3.5rem, 8vh, 5rem);
		box-sizing: border-box;
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* ---------- Aurora backdrop ---------- */
	.aurora {
		position: absolute;
		inset: -10% -5%;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.blob {
		position: absolute;
		width: 46vw;
		height: 46vw;
		max-width: 620px;
		max-height: 620px;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.5;
		will-change: transform;
	}

	.blob-a {
		top: 2%;
		left: 4%;
		background: radial-gradient(circle, var(--pp) 0%, transparent 68%);
		animation: drift-a 22s ease-in-out infinite alternate;
	}

	.blob-b {
		bottom: 0;
		right: 2%;
		background: radial-gradient(circle, var(--blob-2) 0%, transparent 68%);
		animation: drift-b 27s ease-in-out infinite alternate;
	}

	:global(body.light-mode) .blob {
		opacity: 0.3;
	}

	@keyframes drift-a {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(9vw, 5vh, 0) scale(1.15);
		}
	}

	@keyframes drift-b {
		from {
			transform: translate3d(0, 0, 0) scale(1.1);
		}
		to {
			transform: translate3d(-7vw, -6vh, 0) scale(0.95);
		}
	}

	/* Follows the cursor. --px/--py are set from JS and default to centre, so the
	   glow still looks deliberate on touch devices where no pointer event fires. */
	.pointer-glow {
		position: absolute;
		left: var(--px, 50%);
		top: var(--py, 42%);
		width: 34rem;
		height: 34rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: radial-gradient(circle, var(--pp) 0%, transparent 62%);
		opacity: 0.16;
		filter: blur(60px);
	}

	:global(body.light-mode) .pointer-glow {
		opacity: 0.12;
	}

	/* ---------- Status pill ---------- */
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 clamp(1rem, 3vw, 1.5rem);
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: clamp(0.68rem, 1.9vw, 0.78rem);
		letter-spacing: 0.04em;
		color: var(--muted);
		max-width: 100%;
	}

	.status-dot {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
		flex-shrink: 0;
	}

	/* Expanding ring, so the dot reads as live rather than as a static bullet. */
	.status-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #22c55e;
		animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ping {
		0% {
			transform: scale(1);
			opacity: 0.7;
		}
		75%,
		100% {
			transform: scale(2.8);
			opacity: 0;
		}
	}

	/* ---------- Greeting ---------- */
	.greeting {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: clamp(1rem, 2.6vw, 1.2rem);
		color: var(--muted);
		margin: 0 0 0.3rem;
	}

	.wave {
		display: inline-block;
		transform-origin: 70% 70%;
		animation: wave 2.6s ease-in-out infinite;
	}

	@keyframes wave {
		0%,
		60%,
		100% {
			transform: rotate(0deg);
		}
		10%,
		30% {
			transform: rotate(14deg);
		}
		20%,
		40% {
			transform: rotate(-8deg);
		}
	}

	/* ---------- Name ---------- */
	.name {
		font-family: 'ret', system-ui, sans-serif;
		font-size: clamp(2rem, 8.5vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: 2px;
		margin: 0;
		/* Plain solid colour: white on the dark theme, near-black on the light one. */
		color: var(--text-color);
	}

	.ch {
		/* Stays inline on purpose - see the note in the frontmatter. */
		opacity: 0;
		animation: letter-in 0.5s ease forwards;
		animation-delay: calc(0.3s + var(--i) * 0.035s);
	}

	@keyframes letter-in {
		to {
			opacity: 1;
		}
	}

	/* Gradient rule that draws itself out under the name. */
	.rule {
		display: block;
		width: min(20rem, 60%);
		height: 2px;
		margin: clamp(0.9rem, 2.5vw, 1.25rem) 0 clamp(0.8rem, 2vw, 1rem);
		border-radius: 2px;
		background: linear-gradient(90deg, transparent, var(--pp), transparent);
		transform: scaleX(0);
		animation: rule-in 1s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
	}

	@keyframes rule-in {
		to {
			transform: scaleX(1);
		}
	}

	/* ---------- Role ---------- */
	.role {
		display: block;
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(0.85rem, 2.6vw, 1.05rem);
		line-height: 1.5;
		letter-spacing: 0.06em;
		color: var(--text-color);
		margin: 0;
		padding-inline: 0.5rem;
		text-align: center;
		/* Fits on one line on a wide screen but never exceeds the viewport, so it
		   wraps instead of overflowing on a phone. */
		max-width: min(46ch, 100%);
	}

	/* ---------- Buttons ---------- */
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.85rem;
		margin-top: clamp(1.5rem, 4vw, 2.25rem);
	}

	.btn {
		position: relative;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: var(--radius);
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid transparent;
		transition:
			transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
			color 0.3s ease,
			background 0.3s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	/* Light sweeps across the button on hover. */
	.btn::before {
		content: '';
		position: absolute;
		top: 0;
		left: -120%;
		width: 60%;
		height: 100%;
		background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.35), transparent);
		transform: skewX(-18deg);
		transition: left 0.55s ease;
	}

	.btn:hover::before {
		left: 130%;
	}

	/* Keeps the label and icon above the sweep. */
	.btn > * {
		position: relative;
		z-index: 1;
	}

	.btn-primary {
		background: var(--name-bg);
		color: var(--opp);
	}

	.btn-primary:hover {
		color: var(--pp);
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.3);
	}

	.btn-ghost {
		background: var(--surface);
		border-color: var(--border);
		color: var(--text-color);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.btn-ghost:hover {
		border-color: var(--pp);
		color: var(--pp);
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
	}

	.btn-ghost svg {
		width: 18px;
		height: 18px;
		transition: transform 0.3s ease;
	}

	.btn-ghost:hover svg {
		transform: translateX(3px);
	}

	/* ---------- Scroll cue ---------- */
	.scroll-cue {
		position: absolute;
		bottom: clamp(1rem, 3vh, 2rem);
		left: 50%;
		margin-left: -19px;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--muted);
		animation: bob 2.4s ease-in-out infinite;
		transition:
			color 0.3s ease,
			border-color 0.3s ease;
	}

	.scroll-cue:hover {
		color: var(--pp);
		border-color: var(--pp);
	}

	.scroll-cue svg {
		width: 18px;
		height: 18px;
	}

	@keyframes bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}

	/* ---------- About ---------- */
	.about {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		margin-block: clamp(2rem, 8vw, 5rem);
		box-sizing: border-box;
	}

	.photos {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.photo {
		border-radius: 27px;
		box-shadow: var(--shad);
		max-width: 100%;
		/* Each photo keeps its own natural aspect ratio. */
		height: auto;
	}

	.photo-front {
		width: 250px;
	}

	.photo-back {
		width: 220px;
		/* Slight offset keeps the original staggered look without fixed margins. */
		margin-top: clamp(1.5rem, 6vw, 4.5rem);
	}

	.bio {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding: clamp(1.25rem, 3.5vw, 2rem);
		box-shadow: 0 8px 32px rgb(0 0 0 / 0.25);
	}

	.bio-head {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(1rem, 2.8vw, 1.2rem);
		line-height: 1.35;
		margin: 0 0 1rem;
	}

	.bio p {
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: clamp(0.85rem, 2.2vw, 0.95rem);
		line-height: 1.75;
		text-align: justify;
		margin: 0 0 1rem;
		color: var(--muted);
	}

	.bio p:last-child {
		margin-bottom: 0;
	}

	.bio b {
		color: var(--text-color);
		font-weight: 700;
	}

	/* Stack the photos above the bio before the columns get too cramped. */
	@media (max-width: 960px) {
		.about {
			grid-template-columns: minmax(0, 1fr);
		}

		.photos {
			justify-content: center;
		}

		.photo-back {
			margin-top: 2.5rem;
		}
	}

	@media (max-width: 560px) {
		/* Both classes named explicitly so this doesn't rely on source order to beat
		   the fixed .photo-front / .photo-back widths above. */
		.photo-front,
		.photo-back {
			width: calc(50% - 0.5rem);
		}

		.photo-back {
			margin-top: 1.5rem;
		}

		.bio p {
			text-align: left;
		}

		.btn {
			width: 100%;
			justify-content: center;
		}

		.cta-row {
			width: 100%;
			max-width: 22rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		/* Everything decorative that loops or moves is stopped. The letter reveal and
		   the underline still need their end state, so they are held at 100% rather
		   than simply switched off — otherwise the name would stay invisible. */
		.wave,
		.blob,
		.status-dot::after,
		.scroll-cue {
			animation: none;
		}

		.ch {
			animation: none;
			opacity: 1;
		}

		.rule {
			animation: none;
			transform: scaleX(1);
		}

		.btn,
		.btn::before,
		.btn-ghost svg {
			transition: none;
		}

		.btn:hover::before {
			left: -120%;
		}

		.btn:hover {
			transform: none;
		}

		.btn-ghost:hover svg {
			transform: none;
		}
	}
</style>

<script>
	/**
	 * Soft glow in the hero that tracks the pointer.
	 *
	 * Initialisation deliberately has two entry points. `astro:page-load` is what
	 * fires on client-side navigation, but it only ever fires if the view-transition
	 * router script actually loads — if that request fails, anything hung solely off
	 * that event silently never runs. So a readyState fallback covers the first
	 * paint, and a flag on the element keeps the listener from being attached twice.
	 */
	function initPointerGlow() {
		const hero = document.querySelector<HTMLElement>('.hero');
		if (!hero) return;
		if (hero.dataset.glowReady === 'true') return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		hero.dataset.glowReady = 'true';
		let frame = 0;

		hero.addEventListener(
			'pointermove',
			(event) => {
				// Ignore touch: the glow would jump around under the user's finger.
				if (event.pointerType === 'touch') return;
				if (frame) return;

				frame = requestAnimationFrame(() => {
					frame = 0;
					const box = hero.getBoundingClientRect();
					const x = ((event.clientX - box.left) / box.width) * 100;
					const y = ((event.clientY - box.top) / box.height) * 100;
					hero.style.setProperty('--px', `${x.toFixed(2)}%`);
					hero.style.setProperty('--py', `${y.toFixed(2)}%`);
				});
			},
			{ passive: true }
		);
	}

	document.addEventListener('astro:page-load', initPointerGlow);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPointerGlow);
	} else {
		initPointerGlow();
	}
</script>
