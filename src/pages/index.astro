	.gh-link:hover .gh-arrow {
		transform: translate(2px, -2px);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 960px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
		}
		.portrait {
			max-width: 560px;
			width: 100%;
			justify-self: center;
			margin-bottom: 1.5rem;
		}
		.about {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.hero-facts > div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.15rem;
		}
		.hero-cta .btn {
			flex: 1 1 100%;
		}
	}

	@media (max-width: 860px) {
		.index-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.stat {
			margin-left: 0;
		}
		/* 2×2: collapse the doubled hairlines between rows and columns. */
		.stat:nth-child(even) {
			margin-left: -1px;
		}
		.stat:nth-child(n + 3) {
			margin-top: -1px;
		}
