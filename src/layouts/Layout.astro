---
import { ClientRouter } from 'astro:transitions';
import Intro from '../components/Intro.astro';
import SiteNav from '../components/SiteNav.astro';
import Logo from '../components/Logo.astro';
import { GITHUB_USER } from '../data/featured';
import { LINKEDIN_URL } from '../data/certifications';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Gabriel John Solomon',
	description = 'AI Engineer at RivanAI Cybersecurity and student leader at the University of the East – Caloocan, building intelligent systems with Python, computer vision and data science tooling.',
} = Astro.props;

const pageTitle = title === 'Gabriel John Solomon' ? title : `${title} · Gabriel John Solomon`;

/* Page swap: the old sheet sinks back, the new one rises in; mirrored when
   navigating back. Keyframes in global.css. */
const fileSwap = {
	forwards: {
		old: [{ name: 'file-out', duration: '0.38s', easing: 'cubic-bezier(0.7, 0, 0.84, 0)', fillMode: 'forwards' }],
		new: [{ name: 'file-in', duration: '0.7s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', delay: '0.16s', fillMode: 'backwards' }],
	},
	backwards: {
		old: [{ name: 'file-out-back', duration: '0.38s', easing: 'cubic-bezier(0.7, 0, 0.84, 0)', fillMode: 'forwards' }],
		new: [{ name: 'file-in-back', duration: '0.7s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', delay: '0.16s', fillMode: 'backwards' }],
	},
};
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b0b0b" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/logo.png" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Doto:wght@400..900&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=Space+Grotesk:wght@400..700&display=swap"
		/>

		<ClientRouter />

		<!-- Before first paint: whether the intro plays (every full load, never with
		     reduced motion), and whether scroll reveals start hidden. -->
		<script is:inline>
			(function () {
				try {
					var html = document.documentElement;
					if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					html.classList.add('intro');
					html.style.setProperty('--intro-delay', '2.6s');
					if ('IntersectionObserver' in window) {
						html.classList.add('js-reveal');
						// Never leave content hidden if the module script fails to load.
						setTimeout(function () {
							if (window.__revealReady) return;
							document.querySelectorAll('.reveal').forEach(function (el) {
								el.classList.add('is-in');
							});
						}, 4000);
					}
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<!-- Before the body paints, so a light-mode visitor never sees a dark flash. -->
		<script is:inline>
			try {
				if (localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');
			} catch (e) {}
		</script>

		<Intro />

		<div class="sitebar-wrap" transition:persist="sitebar">
			<SiteNav />
		</div>

		<main class="sheet" transition:name="sheet" transition:animate={fileSwap}>
			<slot />

			<footer class="colophon">
				<hr class="double-rule" />
				<div class="colophon-grid">
					<div class="col-brand">
						<Logo size={64} />
						<p class="col-name dot-type">Gabriel John Solomon</p>
					</div>
					<nav class="col-links" aria-label="Elsewhere">
						<a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
						<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
						<a href="/Resume-SOLOMON.pdf" download="Resume-SOLOMON.pdf">Résumé ↓</a>
					</nav>
				</div>
			</footer>
		</main>

		<script>
			/** Mark the current page's link and slide the indicator under it. The
			 *  header is persisted, so a class change mid-navigation animates live. */
			function setActiveTab() {
				const path = window.location.pathname.replace(/\/$/, '') || '/';
				document.querySelectorAll<HTMLAnchorElement>('.seg-link').forEach((link) => {
					const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';
					const on = href === path || (href !== '/' && path.startsWith(href + '/'));
					link.classList.toggle('active', on);
					if (on) link.setAttribute('aria-current', 'page');
					else link.removeAttribute('aria-current');
				});
				positionIndicator();
			}

			let placed = false;
			function positionIndicator() {
				const seg = document.querySelector<HTMLElement>('.seg');
				const active = seg?.querySelector<HTMLElement>('.seg-link.active');
				if (!seg) return;
				if (!active) {
					seg.style.setProperty('--ind-o', '0');
					return;
				}
				// The very first placement snaps into position instead of sliding in.
				if (!placed) seg.classList.add('no-anim');
				seg.style.setProperty('--x', `${active.offsetLeft}px`);
				seg.style.setProperty('--w', `${active.offsetWidth}px`);
				seg.style.setProperty('--ind-o', '1');
				if (!placed) {
					placed = true;
					requestAnimationFrame(() => requestAnimationFrame(() => seg.classList.remove('no-anim')));
				}
			}

			window.addEventListener('resize', positionIndicator);
			document.fonts?.ready.then(positionIndicator);

			function syncToggle() {
				const btn = document.getElementById('theme-toggle');
				btn?.setAttribute('aria-pressed', String(document.body.classList.contains('light-mode')));
			}

			function initTheme() {
				const btn = document.getElementById('theme-toggle');
				if (!btn || window.themeToggleInitialized) return;
				window.themeToggleInitialized = true;
				btn.addEventListener('click', () => {
					if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						document.body.classList.add('theme-anim');
						window.clearTimeout(window.themeAnimTimer);
						window.themeAnimTimer = window.setTimeout(() => document.body.classList.remove('theme-anim'), 520);
					}
					const light = document.body.classList.toggle('light-mode');
					try {
						localStorage.setItem('theme', light ? 'light' : 'dark');
					} catch (e) {}
					syncToggle();
				});
			}

			/** One observer for every `.reveal`, with a short stagger among siblings. */
			let io: IntersectionObserver | null = null;
			function initReveal() {
				window.__revealReady = true;
				if (!document.documentElement.classList.contains('js-reveal')) return;
				io ??= new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							e.target.classList.add('is-in');
							io?.unobserve(e.target);
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
				);
				const seen = new Map<Element, number>();
				document.querySelectorAll<HTMLElement>('.reveal:not([data-rv])').forEach((el) => {
					el.dataset.rv = '';
					const parent = el.parentElement ?? document.body;
					const n = seen.get(parent) ?? 0;
					seen.set(parent, n + 1);
					el.style.setProperty('--d', `${Math.min(n, 6) * 70}ms`);
					io!.observe(el);
				});
			}

			function init() {
				setActiveTab();
				syncToggle();
				initTheme();
				initReveal();
			}

			// astro:page-load covers client-side navigation; the readyState branch
			// covers first paint even if the router script fails to load.
			document.addEventListener('astro:page-load', init);
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
			else init();

			// The body is replaced on navigation: re-apply the theme, and move the
			// active link now so the indicator slides live during the page swap.
			document.addEventListener('astro:after-swap', () => {
				try {
					if (localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');
				} catch (e) {}
				setActiveTab();
				syncToggle();
			});
		</script>

		<style>
			.sitebar-wrap {
				position: sticky;
				top: 0;
				z-index: 100;
				/* Its own live layer during page swaps, so the nav indicator slides in
				   real time above the sheet instead of freezing as a snapshot. */
				view-transition-name: sitebar;
				animation: bar-in 0.9s var(--ease) var(--intro-delay, 0s) both;
			}

			@keyframes bar-in {
				from {
					opacity: 0;
					transform: translateY(-100%);
				}
			}

			.sheet {
				display: block;
				position: relative;
				min-height: calc(100vh - var(--header-h));
				background-color: var(--sheet);
				background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
				background-size: 18px 18px;
				background-position: center top;
			}

			/* ---------- Colophon ---------- */
			.colophon {
				max-width: var(--content-width);
				margin: clamp(2rem, 6vw, 4rem) auto 0;
				padding: 0 var(--gutter) 1.5rem;
			}

			.colophon-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: clamp(1rem, 4vw, 3rem);
				align-items: end;
				padding: clamp(1.5rem, 4vw, 2.5rem) 0;
			}

			.col-brand {
				display: flex;
				align-items: flex-end;
				gap: 1rem;
				color: var(--fg);
			}

			.col-name {
				margin: 0;
				max-width: 8ch;
				font-size: 1.15rem;
				line-height: 1;
				text-transform: uppercase;
			}

			.col-links {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-family: var(--f-mono);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.col-links a {
				text-decoration: none;
				background-image: linear-gradient(var(--red), var(--red));
				background-size: 0% 1.5px;
				background-position: 0 100%;
				background-repeat: no-repeat;
				transition:
					background-size 0.35s var(--ease),
					color 0.25s var(--ease);
			}

			.col-links a:hover {
				background-size: 100% 1.5px;
				color: var(--red-text);
			}

			@media (max-width: 760px) {
				.colophon-grid {
					grid-template-columns: minmax(0, 1fr);
					align-items: start;
				}
				.col-links {
					flex-direction: row;
					flex-wrap: wrap;
					gap: 1.25rem;
				}
			}
		</style>

		<style is:global>
			/* Header layer: shown live, never cross-faded. */
			::view-transition-group(sitebar) {
				z-index: 10;
				animation: none;
			}
			::view-transition-old(sitebar) {
				display: none;
			}
			::view-transition-new(sitebar) {
				animation: none;
			}
		</style>
	</body>
</html>
