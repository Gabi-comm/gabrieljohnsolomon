---
/**
 * Masthead for the inner pages: a double rule over a huge dot-matrix title.
 */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="page-head">
	<hr class="double-rule" />
	<h1 class="ph-title dot-type">{title}</h1>
	<hr class="rule-thin" />
</header>

<style>
	.page-head {
		margin-bottom: clamp(1.75rem, 4.5vw, 3rem);
	}

	.ph-title {
		margin: clamp(0.6rem, 2vw, 1.1rem) 0 0;
		font-size: clamp(2.8rem, 11vw, 8.5rem);
		font-weight: 900;
		line-height: 0.88;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
		animation: ph-in 0.9s var(--ease) both;
	}

	@media (max-width: 760px), (hover: none) {
		.ph-title {
			animation-name: head-lite;
		}
	}

	@keyframes head-lite {
		from {
			opacity: 0;
			translate: 0 14px;
		}
	}

	@keyframes ph-in {
		from {
			opacity: 0;
			letter-spacing: 0.12em;
			filter: blur(6px);
		}
	}

	.rule-thin {
		border: 0;
		border-top: 1px solid var(--line);
		margin: clamp(1.1rem, 3vw, 1.75rem) 0 0;
	}
</style>
