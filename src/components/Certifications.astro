---
/**
 * Home-page certifications highlight.
 *
 * Shows just the three featured credentials; the full, grouped gallery of every
 * certificate, seminar and badge lives on /certificates.
 */
import Section from './Section.astro';
import CertCard from './CertCard.astro';
import { certifications } from '../data/certifications';

const featured = certifications.filter((c) => c.featured).slice(0, 3);
const total = certifications.length;
---

<Section
	id="certifications"
	eyebrow="Certifications"
	title="Credentials & training"
	subtitle="A few highlights below — see every certificate, seminar and badge in one place."
	bare
>
	<div class="grid">
		{featured.map((cert) => <CertCard cert={cert} />)}
	</div>

	<div class="more">
		<a class="ghost-btn" href="/certificates">
			View all {total} certificates
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
				<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round"></path>
			</svg>
		</a>
	</div>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.more {
		display: flex;
		justify-content: center;
		margin-top: clamp(1.5rem, 4vw, 2.25rem);
	}

	.ghost-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.7rem 1.35rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-color);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.3s ease,
			color 0.3s ease,
			transform 0.3s ease,
			background 0.3s ease;
	}

	.ghost-btn:hover {
		border-color: var(--pp);
		color: var(--pp);
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	.ghost-btn svg {
		width: 15px;
		height: 15px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ghost-btn {
			transition: none;
		}
		.ghost-btn:hover {
			transform: none;
		}
	}
</style>
