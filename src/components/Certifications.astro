---
/**
 * Home-page certifications highlight: the three featured credentials. The full,
 * grouped gallery lives on /certificates.
 */
import Section from './Section.astro';
import CertCard from './CertCard.astro';
import { certifications } from '../data/certifications';

const featured = certifications.filter((c) => c.featured).slice(0, 3);
const total = certifications.length;
---

<Section id="certifications" num="04" eyebrow="Certifications" title="Credentials & training." bare>
	<div class="clip-grid">
		{featured.map((cert) => <CertCard cert={cert} />)}
	</div>

	<div class="more-row">
		<a class="ghost-btn" href="/certificates">
			View all {total} certificates
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
				<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="square"></path>
			</svg>
		</a>
	</div>
</Section>

<style>
	.clip-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.4vw, 1.6rem);
	}

	@media (max-width: 900px) {
		.clip-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.clip-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
