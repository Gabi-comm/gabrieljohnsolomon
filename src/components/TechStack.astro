---
/**
 * Tech stack, grouped by category, set as a listings table.
 *
 * Icons are real brand SVGs from `public/icons/`, drawn with a CSS mask so one
 * monochrome file takes the text colour by default and the brand colour on hover.
 * `--brand` / `--brand-light` are set per item (see `src/data/tech.ts`).
 */
import Section from './Section.astro';
import { techCategories } from '../data/tech';
---

<Section
	id="stack"
	num="05"
	eyebrow="Tech stack"
	title="Tools of the trade."
	subtitle="The languages, frameworks and platforms I reach for across machine learning, data and automation work."
	bare
>
	<div class="listing">
		{
			techCategories.map((category, i) => (
				<div class="row reveal">
					<h3 class="row-label">
						<span class="dot-type row-no">{String(i + 1).padStart(2, '0')}</span>
						{category.label}
					</h3>
					<ul class="chips">
						{category.items.map((tech) => (
							<li class="chip" style={`--brand:${tech.brand};--brand-light:${tech.brandLight ?? tech.brand}`}>
								<span class="chip-icon" style={`--icon:url('/icons/${tech.icon}.svg')`} aria-hidden="true" />
								<span>{tech.name}</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</Section>

<style>
	.listing {
		border-top: 1.5px solid var(--line-strong);
	}

	.row {
		display: grid;
		grid-template-columns: 14rem minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
		padding: clamp(1rem, 2.6vw, 1.4rem) 0;
		border-bottom: 1px solid var(--line);
	}

	.row-label {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		margin: 0;
		padding-top: 0.45rem;
		font-family: var(--f-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.row-no {
		font-size: 1.1rem;
		color: var(--red-text);
		letter-spacing: 0;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.8rem;
		border: 1.5px solid var(--line);
		background: var(--card);
		font-family: var(--f-head);
		font-size: 0.88rem;
		font-weight: 500;
		white-space: nowrap;
		cursor: default;
		transition:
			color 0.25s var(--ease),
			border-color 0.25s var(--ease),
			transform 0.25s var(--ease);
	}

	.chip:hover {
		color: var(--brand);
		border-color: currentColor;
		transform: translateY(-2px);
	}

	:global(body.light-mode) .chip:hover {
		color: var(--brand-light);
	}

	.chip-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		background-color: currentColor;
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}

	@media (max-width: 720px) {
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.7rem;
		}
		.row-label {
			padding-top: 0;
		}
	}
</style>
