---
/**
 * First-visit intro: the "G." mark traces itself bar by bar, the dot drops in
 * and blinks like a cursor, then the "Gabi-comm" lockup types out and a curtain
 * lifts to reveal the page.
 *
 * Whether it plays is decided by the inline script in Layout's <head> (every
 * full page load, never with reduced motion), which adds `intro` to <html>. Without that
 * class this overlay is display:none and removes itself.
 *
 * The mark is drawn on the logo's own 13×10 unit grid (one unit = 24px in
 * Logo.png), so every bar is a crisp rectangle.
 */
const name = 'Gabi-comm'.split('');
const tagline = 'Gab Builds and Creates';
---

<div id="intro" aria-hidden="true">
	<div class="intro-lockup">
		<svg class="intro-mark" viewBox="0 0 13 10" shape-rendering="crispEdges">
			<rect class="bar bar-top" x="0" y="0" width="10" height="2"></rect>
			<rect class="bar bar-left" x="0" y="0" width="2" height="10"></rect>
			<rect class="bar bar-bottom" x="0" y="8" width="10" height="2"></rect>
			<rect class="bar bar-right" x="8" y="5" width="2" height="3"></rect>
			<rect class="bar bar-tab" x="5" y="5" width="5" height="2"></rect>
			<rect class="intro-dot" x="11" y="8" width="2" height="2"></rect>
		</svg>
		<div class="intro-words">
			<span class="intro-name">{name.map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</span>
			<span class="intro-tag" style={`--len:${tagline.length}`}>
				<span class="intro-tag-text">{tagline}</span>
			</span>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		var html = document.documentElement;
		var intro = document.getElementById('intro');
		if (!intro) return;
		// Client-side navigations re-run this; the class is gone by then.
		if (!html.classList.contains('intro')) {
			intro.remove();
			return;
		}

		// The mark starts centred on its own, then slides left as the words arrive.
		var lockup = intro.querySelector('.intro-lockup');
		var words = intro.querySelector('.intro-words');
		var center = function () {
			var gap = parseFloat(getComputedStyle(lockup).columnGap) || 0;
			lockup.style.setProperty('--shift', (words.offsetWidth + gap) / 2 + 'px');
		};
		center();
		if (document.fonts) document.fonts.ready.then(center);

		var done = false;
		var events = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
		var finish = function () {
			if (done) return;
			done = true;
			html.classList.remove('intro', 'intro-skip');
			intro.remove();
			events.forEach(function (e) {
				window.removeEventListener(e, skip);
			});
		};
		var skip = function () {
			// Past ~2.4s the curtain is already lifting; let it finish.
			if (performance.now() > 2400 || html.classList.contains('intro-skip')) return;
			html.classList.add('intro-skip');
			// The page's own entrance animations wait on this; start them now.
			html.style.setProperty('--intro-delay', (performance.now() / 1000 + 0.15).toFixed(2) + 's');
		};
		events.forEach(function (e) {
			window.addEventListener(e, skip, { passive: true });
		});
		intro.addEventListener('animationend', function (e) {
			if (e.target === intro) finish();
		});
		// Never leave the page locked if an animation event goes missing.
		setTimeout(finish, 5000);
	})();
</script>

<style is:global>
	html.intro {
		overflow: hidden;
	}

	#intro {
		display: none;
	}

	html.intro #intro {
		/* One unit of the logo grid; the mark is 13×10 units. */
		--u: clamp(5.5px, 0.85vw, 9px);
		--mark: #6d4ae0;
		display: grid;
		place-items: center;
		position: fixed;
		inset: 0;
		/* Above the dock, which sits at 9999. */
		z-index: 10000;
		background-color: var(--bg-color);
		background-image: var(--bg-gradient);
		clip-path: inset(0 0 0 0);
		animation: intro-curtain 0.75s cubic-bezier(0.76, 0, 0.24, 1) 2.45s forwards;
	}

	/* Light theme: the mark takes the theme's terracotta accent instead of purple. */
	body.light-mode #intro {
		--mark: var(--pp);
	}

	html.intro-skip #intro {
		animation: intro-fade 0.3s ease forwards;
	}

	@keyframes intro-curtain {
		to {
			clip-path: inset(0 0 100% 0);
			visibility: hidden;
		}
	}

	@keyframes intro-fade {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}

	#intro .intro-lockup {
		display: flex;
		align-items: center;
		gap: calc(var(--u) * 3.6);
		transform: translateX(var(--shift, 0));
		animation:
			intro-slide 0.6s cubic-bezier(0.65, 0, 0.35, 1) 1s forwards,
			intro-lift 0.45s cubic-bezier(0.5, 0, 0.75, 0) 2.3s forwards;
	}

	@keyframes intro-slide {
		to {
			transform: translateX(0);
		}
	}

	@keyframes intro-lift {
		from {
			transform: translateX(0);
			opacity: 1;
		}
		to {
			transform: translate(0, calc(var(--u) * -4));
			opacity: 0;
		}
	}

	/* ---------- Mark: each bar grows in pixel steps, tracing the G ---------- */
	#intro .intro-mark {
		width: calc(var(--u) * 13);
		height: calc(var(--u) * 10);
		flex-shrink: 0;
		overflow: visible;
	}

	#intro .bar {
		fill: var(--mark);
		transform-box: fill-box;
	}

	#intro .bar-top {
		transform-origin: right;
		transform: scaleX(0);
		animation: intro-grow-x 0.2s steps(5, end) 0.15s forwards;
	}

	#intro .bar-left {
		transform-origin: top;
		transform: scaleY(0);
		animation: intro-grow-y 0.2s steps(5, end) 0.35s forwards;
	}

	#intro .bar-bottom {
		transform-origin: left;
		transform: scaleX(0);
		animation: intro-grow-x 0.2s steps(5, end) 0.55s forwards;
	}

	#intro .bar-right {
		transform-origin: bottom;
		transform: scaleY(0);
		animation: intro-grow-y 0.12s steps(3, end) 0.75s forwards;
	}

	#intro .bar-tab {
		transform-origin: right;
		transform: scaleX(0);
		animation: intro-grow-x 0.15s steps(5, end) 0.87s forwards;
	}

	@keyframes intro-grow-x {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes intro-grow-y {
		to {
			transform: scaleY(1);
		}
	}

	/* The dot lands, then blinks twice like a cursor. */
	#intro .intro-dot {
		fill: var(--text-color);
		transform-box: fill-box;
		opacity: 0;
		animation:
			intro-dot-drop 0.45s cubic-bezier(0.22, 1, 0.36, 1) 1.05s forwards,
			intro-blink 0.32s steps(1, end) 1.6s 2;
	}

	@keyframes intro-dot-drop {
		from {
			opacity: 1;
			transform: translateY(-450%);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes intro-blink {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	/* ---------- Words ---------- */
	#intro .intro-words {
		display: flex;
		flex-direction: column;
		gap: calc(var(--u) * 0.9);
	}

	#intro .intro-name {
		display: flex;
		font-family: 'Space Grotesk', 'pop-bold', system-ui, sans-serif;
		font-weight: 600;
		font-size: calc(var(--u) * 6.6);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--text-color);
	}

	#intro .intro-name span {
		display: inline-block;
		opacity: 0;
		transform: translateY(35%);
		animation: intro-letter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
		animation-delay: calc(1.15s + var(--i) * 0.045s);
	}

	@keyframes intro-letter {
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* Typed in a fixed-width box so the lockup never shifts while it types. */
	#intro .intro-tag {
		display: flex;
		align-items: center;
		width: calc(var(--len) * 1ch + 0.7em);
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: calc(var(--u) * 2.4);
		line-height: 1.2;
		color: var(--muted);
	}

	#intro .intro-tag-text {
		display: inline-block;
		width: 0;
		overflow: hidden;
		white-space: nowrap;
		animation: intro-type 0.75s steps(var(--len), end) 1.5s forwards;
	}

	@keyframes intro-type {
		to {
			width: calc(var(--len) * 1ch);
		}
	}

	#intro .intro-tag::after {
		content: '';
		width: 0.55em;
		height: 1.05em;
		margin-left: 0.15em;
		background: var(--mark);
		visibility: hidden;
		animation:
			intro-show 0s linear 1.45s forwards,
			intro-blink 0.5s steps(1, end) 1.45s infinite;
	}

	@keyframes intro-show {
		to {
			visibility: visible;
		}
	}
</style>
