---
/**
 * Full-load intro: the dot-matrix "G." lights up dot by dot like a Nothing glyph
 * panel, the red full stop blinks, the name prints in Doto, the tagline types
 * out, then the screen wipes upward to reveal the page.
 *
 * Whether it plays is decided by the inline script in Layout's <head> (every
 * full page load, never with reduced motion), which adds `intro` to <html>.
 * Client-side navigation never replays it. Any key/pointer/wheel skips it.
 */
import Logo from './Logo.astro';

// One line per word, letters indexed across the whole name for the print-on stagger.
let k = 0;
const words = ['GABRIEL', 'JOHN', 'SOLOMON'].map((w) => [...w].map((c) => ({ c, i: k++ })));
const tagline = 'GAB BUILDS AND CREATES';
---

<div id="intro" aria-hidden="true">
	<div class="intro-lockup">
		<Logo size={120} animated class="intro-mark" />
		<div class="intro-words">
			<span class="intro-name">
				{words.map((w) => (
					<span class="w">{w.map(({ c, i }) => <span style={`--i:${i}`}>{c}</span>)}</span>
				))}
			</span>
			<span class="intro-tag" style={`--len:${tagline.length}`}>
				<span class="intro-tag-text">{tagline}</span>
			</span>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		var html = document.documentElement;
		var intro = document.getElementById('intro');
		if (!intro) return;
		if (!html.classList.contains('intro')) {
			intro.remove();
			return;
		}

		var done = false;
		var events = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
		var finish = function () {
			if (done) return;
			done = true;
			html.classList.remove('intro', 'intro-skip');
			intro.remove();
			events.forEach(function (e) {
				window.removeEventListener(e, skip);
			});
		};
		var skip = function () {
			if (performance.now() > 2300 || html.classList.contains('intro-skip')) return;
			html.classList.add('intro-skip');
			html.style.setProperty('--intro-delay', (performance.now() / 1000 + 0.15).toFixed(2) + 's');
		};
		events.forEach(function (e) {
			window.addEventListener(e, skip, { passive: true });
		});
		intro.addEventListener('animationend', function (e) {
			if (e.target === intro) finish();
		});
		setTimeout(finish, 4800);
	})();
</script>

<style is:global>
	html.intro {
		overflow: hidden;
	}

	#intro {
		display: none;
	}

	html.intro #intro {
		display: grid;
		place-items: center;
		position: fixed;
		inset: 0;
		z-index: 10000;
		background-color: var(--bg);
		background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
		background-size: 18px 18px;
		color: var(--fg);
		clip-path: inset(0 0 0 0);
		animation: intro-wipe 0.8s cubic-bezier(0.76, 0, 0.24, 1) 2.35s forwards;
	}

	html.intro-skip #intro {
		animation: intro-fade 0.3s ease forwards;
	}

	@keyframes intro-wipe {
		to {
			clip-path: inset(0 0 100% 0);
			visibility: hidden;
		}
	}

	@keyframes intro-fade {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}

	#intro .intro-lockup {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		padding-inline: 24px;
		animation: intro-lift 0.5s cubic-bezier(0.5, 0, 0.75, 0) 2.15s forwards;
	}

	@keyframes intro-lift {
		to {
			transform: translateY(-28px);
			opacity: 0;
		}
	}

	#intro .intro-mark {
		width: clamp(84px, 14vw, 132px);
		height: auto;
		flex-shrink: 0;
	}

	/* Each lit dot pops on in sweep order. */
	#intro .intro-mark .on {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(0.2);
		animation: dot-on 0.22s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
		animation-delay: calc(0.12s + var(--i) * 13ms);
	}

	@keyframes dot-on {
		to {
			opacity: 1;
			transform: none;
		}
	}

	#intro .intro-mark .period {
		opacity: 0;
		animation:
			intro-show 0s linear 0.95s forwards,
			intro-blink 0.34s steps(1, end) 1.05s 3;
	}

	@keyframes intro-show {
		to {
			opacity: 1;
		}
	}

	@keyframes intro-blink {
		50% {
			opacity: 0;
		}
	}

	#intro .intro-words {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
	}

	#intro .intro-name {
		display: flex;
		flex-direction: column;
		font-family: var(--f-dot);
		font-weight: 900;
		font-size: clamp(1.9rem, 6vw, 4rem);
		line-height: 0.95;
		letter-spacing: 0.01em;
	}

	#intro .intro-name .w {
		white-space: nowrap;
	}

	#intro .intro-name .w span {
		opacity: 0;
		animation: intro-letter 0.01s steps(1) forwards;
		animation-delay: calc(0.9s + var(--i) * 32ms);
	}

	@keyframes intro-letter {
		to {
			opacity: 1;
		}
	}

	#intro .intro-tag {
		display: flex;
		align-items: center;
		font-family: var(--f-mono);
		font-size: clamp(0.62rem, 1.4vw, 0.78rem);
		letter-spacing: 0.14em;
		color: var(--muted);
	}

	#intro .intro-tag-text {
		display: inline-block;
		width: 0;
		overflow: hidden;
		white-space: nowrap;
		animation: intro-type 0.7s steps(var(--len), end) 1.55s forwards;
	}

	@keyframes intro-type {
		to {
			width: calc(var(--len) * 1ch + var(--len) * 0.14em);
		}
	}

	#intro .intro-tag::after {
		content: '';
		width: 0.6em;
		height: 1.1em;
		margin-left: 0.25em;
		background: var(--red);
		visibility: hidden;
		animation:
			intro-vis 0s linear 1.5s forwards,
			intro-blink 0.5s steps(1, end) 1.5s infinite;
	}

	@keyframes intro-vis {
		to {
			visibility: visible;
		}
	}

</style>
