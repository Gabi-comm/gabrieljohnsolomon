---
/**
 * One repository card, set as a cell of a joined newspaper grid. Must render
 * correctly when `meta` is null (GitHub unreachable or rate-limiting at build
 * time) — the live chips are simply omitted and the local copy carries the card.
 */
import type { FeaturedRepo } from '../data/featured';
import { GITHUB_USER } from '../data/featured';
import { relativeDate, type RepoMeta } from '../lib/github';
import { projects } from '../data/projects';

interface Props {
	repo: FeaturedRepo;
	meta: RepoMeta | null;
}

const { repo, meta } = Astro.props;

const url = meta?.url ?? `https://github.com/${GITHUB_USER}/${repo.slug}`;
// Prefer the on-site write-up when the project has one.
const detail = projects.some((p) => p.slug === repo.slug) ? `/projects/${repo.slug}` : null;
const updated = relativeDate(meta?.pushedAt ?? null);
const languages = meta?.languages.slice(0, 2) ?? [];
---

<article class="cell reveal">
	<div class="cell-top">
		<span class="cell-no dot-type" aria-hidden="true"></span>
		{
			meta && meta.stars > 0 && (
				<span class="stat" title={`${meta.stars} stars`}>
					★ {meta.stars}
				</span>
			)
		}
		<span class="repo-mark" aria-hidden="true"></span>
	</div>

	<h3 class="cell-title">
		{detail ? <a href={detail}>{repo.title}</a> : <a href={url} target="_blank" rel="noopener noreferrer">{repo.title}</a>}
	</h3>

	<p class="cell-blurb">{repo.blurb}</p>

	<ul class="tag-list" aria-label="Topics">
		{repo.tags.map((tag) => <li>{tag}</li>)}
	</ul>

	<footer class="cell-foot">
		<span class="langs">
			{languages.map((lang) => <span class="lang">{lang}</span>)}
			{meta?.isFork && <span class="lang fork">Fork</span>}
		</span>
		{updated && <span>Upd. {updated}</span>}
	</footer>

	<div class="cell-links">
		<a class="link" href={url} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
		{repo.demoUrl && <a class="link" href={repo.demoUrl} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
	</div>
</article>

<style>
	.cell {
		counter-increment: item;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: clamp(1.1rem, 2.4vw, 1.5rem);
		background: var(--card);
		border-right: 1.5px solid var(--line-strong);
		border-bottom: 1.5px solid var(--line-strong);
		transition: background-color 0.35s var(--ease);
	}

	/* Red bar wipes across the top on hover. */
	.cell::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--red);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s var(--ease);
	}

	.cell:hover {
		background: var(--card-2);
	}

	.cell:hover::before {
		transform: scaleX(1);
	}

	.cell-top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.cell-no::before {
		content: counter(item, decimal-leading-zero);
	}

	.cell-no {
		font-size: 1.6rem;
		line-height: 1;
		color: var(--fg);
	}

	.stat {
		font-family: var(--f-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	.repo-mark {
		margin-left: auto;
		width: 20px;
		height: 20px;
		background-color: var(--muted);
		-webkit-mask: url('/icons/github.svg') center / contain no-repeat;
		mask: url('/icons/github.svg') center / contain no-repeat;
		transition: background-color 0.3s var(--ease);
	}

	.cell:hover .repo-mark {
		background-color: var(--red-text);
	}

	.cell-title {
		margin: 0.25rem 0 0;
		font-family: var(--f-head);
		font-weight: 700;
		font-size: 1.3rem;
		line-height: 1.12;
		letter-spacing: -0.025em;
	}

	.cell-title a {
		text-decoration: none;
	}

	/* Whole cell clickable through the title. */
	.cell-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.cell-blurb {
		margin: 0;
		flex-grow: 1;
		font-size: 0.98rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.cell-foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 0.7rem;
		border-top: 1px dashed var(--line);
		font-family: var(--f-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.langs {
		display: flex;
		gap: 0.8rem;
	}

	.lang {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.lang::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--fg);
	}

	.lang:first-child::before {
		background: var(--red);
	}

	.lang.fork::before {
		background: var(--muted);
	}

	.cell-links {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 1.1rem;
	}

	.link {
		font-family: var(--f-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--red-text);
	}

	.link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
