---
/**
 * "Featured work" section. Fetches live metadata for every featured repo at build
 * time, then renders one RepoCard each.
 */
import Section from './Section.astro';
import RepoCard from './RepoCard.astro';
import { featuredRepos, GITHUB_USER } from '../data/featured';
import { fetchRepos } from '../lib/github';

// Runs at build time. `fetchRepos` never throws — a failed lookup yields null and
// the card falls back to local copy.
const metas = await fetchRepos(featuredRepos.map((r) => r.slug));
---

<Section
	id="work"
	eyebrow="Featured work"
	title="Projects I'm proud of"
	subtitle="Machine learning, computer vision and automation work — pulled live from my GitHub at build time."
	bare
>
	<div class="grid">
		{featuredRepos.map((repo, i) => <RepoCard repo={repo} meta={metas[i] ?? null} />)}
	</div>

	<div class="all-repos">
		<a
			class="ghost-btn"
			href={`https://github.com/${GITHUB_USER}?tab=repositories`}
			target="_blank"
			rel="noopener noreferrer"
		>
			<span class="gh-mark" aria-hidden="true"></span>
			Browse all repositories
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
				><path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="round"></path></svg
			>
		</a>
	</div>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
	}

	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.all-repos {
		display: flex;
		justify-content: center;
		margin-top: clamp(1.5rem, 4vw, 2.25rem);
	}

	.ghost-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.7rem 1.35rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-color);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.3s ease,
			color 0.3s ease,
			transform 0.3s ease,
			background 0.3s ease;
	}

	.ghost-btn:hover {
		border-color: var(--pp);
		color: var(--pp);
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	.gh-mark {
		width: 17px;
		height: 17px;
		background-color: currentColor;
		mask: url('/icons/github.svg') center / contain no-repeat;
		-webkit-mask: url('/icons/github.svg') center / contain no-repeat;
	}

	.ghost-btn svg {
		width: 15px;
		height: 15px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ghost-btn {
			transition: none;
		}
		.ghost-btn:hover {
			transform: none;
		}
	}
</style>
