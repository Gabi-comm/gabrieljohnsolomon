---
/**
 * "Featured work" section. Fetches live metadata for every featured repo at build
 * time, then renders one RepoCard each, set as a joined newspaper grid.
 */
import Section from './Section.astro';
import RepoCard from './RepoCard.astro';
import { featuredRepos, GITHUB_USER } from '../data/featured';
import { fetchRepos } from '../lib/github';

// Runs at build time. `fetchRepos` never throws — a failed lookup yields null and
// the card falls back to local copy.
const metas = await fetchRepos(featuredRepos.map((r) => r.slug));
---

<Section
	id="work"
	num="03"
	eyebrow="Featured work"
	title="Selected repositories."
	bare
>
	<div class="news-grid">
		{featuredRepos.map((repo, i) => <RepoCard repo={repo} meta={metas[i] ?? null} />)}
	</div>

	<div class="more-row">
		<a class="ghost-btn" href={`https://github.com/${GITHUB_USER}?tab=repositories`} target="_blank" rel="noopener noreferrer">
			<span class="gh-mark" aria-hidden="true"></span>
			Browse all repositories
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
				><path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="square"></path></svg
			>
		</a>
	</div>
</Section>

<style>
	/* Joined grid: the container draws the top/left rules, each card its
	   right/bottom, so cells share single hairlines like newspaper columns. */
	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1.5px solid var(--line-strong);
		border-left: 1.5px solid var(--line-strong);
		counter-reset: item;
	}

	@media (max-width: 1024px) {
		.news-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.news-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
