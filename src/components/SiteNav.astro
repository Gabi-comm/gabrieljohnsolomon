---
/**
 * Primary navigation: a minimal segmented control in the Nothing-OS idiom.
 * One hairline-outlined track, mono labels, and a solid indicator that slides
 * to the active page. The header is persisted across navigations, so the
 * indicator glides from the old page to the new one instead of re-rendering.
 * Positioning lives in Layout's script (`positionIndicator`).
 */
import Logo from './Logo.astro';

const LINKS = [
	{ href: '/', label: 'Home', short: 'Home', no: '01' },
	{ href: '/projects', label: 'Projects', short: 'Work', no: '02' },
	{ href: '/exp', label: 'Experience', short: 'Exp', no: '03' },
	{ href: '/certificates', label: 'Certificates', short: 'Certs', no: '04' },
];
---

<header class="sitebar">
	<div class="sitebar-inner">
		<a href="/" class="brand" aria-label="Gabriel John Solomon — home">
			<Logo size={34} class="brand-mark" />
			<span class="brand-text">
				<span>Gabriel John</span>
				<span>Solomon</span>
			</span>
		</a>

		<nav class="seg" aria-label="Primary">
			<span class="seg-ind" aria-hidden="true"></span>
			{
				LINKS.map((l) => (
					<a href={l.href} class="seg-link">
						<span class="seg-no">{l.no}</span>
						<span class="seg-label">
							<span class="full">{l.label}</span>
							<span class="short">{l.short}</span>
						</span>
					</a>
				))
			}
		</nav>

		<div class="tools">
			<button id="theme-toggle" class="switch" type="button" aria-label="Toggle light theme" aria-pressed="false">
				<span class="switch-track">
					<span class="switch-knob"></span>
				</span>
			</button>
		</div>
	</div>
</header>

<style>
	.sitebar {
		height: var(--header-h);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: saturate(1.2) blur(10px);
		-webkit-backdrop-filter: saturate(1.2) blur(10px);
		border-bottom: 1px solid var(--line);
	}

	@media (max-width: 760px), (hover: none) {
		.sitebar {
			background: color-mix(in srgb, var(--bg) 97%, transparent);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	.sitebar-inner {
		height: 100%;
		max-width: calc(var(--content-width) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
	}

	/* ---------- Brand ---------- */
	.brand {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		color: var(--fg);
	}

	.brand :global(.brand-mark) {
		transition: transform 0.4s var(--ease);
	}

	.brand:hover :global(.brand-mark) {
		transform: scale(1.06);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		line-height: 1.35;
	}

	/* ---------- Segmented control ---------- */
	.seg {
		position: relative;
		display: flex;
		align-items: center;
		padding: 3px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		isolation: isolate;
	}

	/* Solid pill that slides under the active link. --x / --w are set from JS;
	   until then it stays invisible, so no-JS visitors just see the outline. */
	.seg-ind {
		position: absolute;
		z-index: -1;
		top: 3px;
		bottom: 3px;
		left: 0;
		width: var(--w, 0px);
		border-radius: 999px;
		background: var(--fg);
		transform: translateX(var(--x, 0px));
		opacity: var(--ind-o, 0);
		transition:
			transform 0.55s var(--ease),
			width 0.55s var(--ease),
			opacity 0.3s var(--ease);
	}

	/* First placement shouldn't animate in from the left edge. */
	.seg.no-anim .seg-ind {
		transition: none;
	}

	.seg-link {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.95rem;
		border-radius: 999px;
		color: var(--muted);
		text-decoration: none;
		font-family: var(--f-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 0.35s var(--ease);
	}

	.seg-link:hover {
		color: var(--fg);
	}

	.seg-no {
		font-family: var(--f-dot);
		font-size: 0.9rem;
		font-weight: 900;
		letter-spacing: 0;
		transition: color 0.35s var(--ease);
	}

	.short {
		display: none;
	}

	.seg-link.active {
		color: var(--bg);
	}

	.seg-link.active .seg-no {
		color: var(--red);
	}

	/* ---------- Tools ---------- */
	.tools {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	/* Nothing-style toggle: a pill track with a dot knob; red in light mode. */
	.switch {
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		color: var(--fg);
	}

	.switch-track {
		position: relative;
		display: block;
		width: 50px;
		height: 26px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background-image: radial-gradient(circle, var(--line) 1px, transparent 1.3px);
		background-size: 6px 6px;
	}

	.switch-knob {
		position: absolute;
		top: 3px;
		left: 3px;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--fg);
		transition:
			transform 0.45s var(--ease),
			background-color 0.35s var(--ease);
	}

	:global(body.light-mode) .switch-knob {
		transform: translateX(24px);
		background: var(--red);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 860px) {
		.brand-text {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.sitebar-inner {
			grid-template-columns: auto 1fr auto;
			gap: 0.6rem;
		}
		.seg {
			justify-self: center;
		}
		.seg-no,
		.full {
			display: none;
		}
		.short {
			display: inline;
		}
		.seg-link {
			padding: 0.45rem 0.6rem;
			font-size: 0.6rem;
			letter-spacing: 0.08em;
		}
		.brand :global(.brand-mark) {
			width: 26px;
			height: auto;
		}
		.switch-track {
			width: 42px;
			height: 22px;
		}
		.switch-knob {
			width: 14px;
			height: 14px;
		}
		:global(body.light-mode) .switch-knob {
			transform: translateX(20px);
		}
	}
</style>
