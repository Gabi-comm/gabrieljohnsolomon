---
/**
 * The inner content of the experience section: highlight stats, the role timeline
 * (grouped into professional and leadership work), awards, and memberships that
 * have no timeline role. Shared between the home-page teaser (which caps the
 * timeline with `limit` and shows a "View all" link) and the full /exp page.
 */
import {
	experiences,
	organizations,
	highlights,
	awards,
	competitions,
	KIND_LABEL,
	type ExperienceKind,
} from '../data/experience';

interface Props {
	/** Cap the timeline to the first N roles and show a link to the full page. */
	limit?: number;
}

const { limit } = Astro.props;
const shown = limit ? experiences.slice(0, limit) : experiences;
const hasMore = limit !== undefined && experiences.length > limit;

const KIND_ORDER: ExperienceKind[] = ['professional', 'leadership'];
const groups = KIND_ORDER.map((kind) => ({
	kind,
	label: KIND_LABEL[kind],
	items: shown.filter((e) => e.kind === kind),
})).filter((g) => g.items.length > 0);
---

<div class="exp" data-exp-reveal>
	<div class="highlights">
		{
			highlights.map((h, i) => (
				<div class="highlight reveal">
					<span class="hl-no">{String(i + 1).padStart(2, '0')}</span>
					<span class="highlight-label dot-type">{h.label}</span>
					<span class="highlight-detail">{h.detail}</span>
				</div>
			))
		}
	</div>

	{
		groups.map((group) => (
			<section class="group" aria-label={group.label}>
				<h3 class="group-label">
					{group.label}
					<span class="group-count dot-type">{group.items.length}</span>
				</h3>

				<ol class="timeline">
					{group.items.map((item) => (
						<li class:list={['entry', 'reveal', { current: item.current }]}>
							<span class="avatar-wrap" aria-hidden="true">
								<span class:list={['avatar', { inset: item.logoInset }]}>
									{item.logo ? (
										<img src={item.logo} alt="" width="44" height="44" loading="lazy" decoding="async" />
									) : (
										<span class="initials">{item.initials ?? item.org.charAt(0)}</span>
									)}
								</span>
							</span>

							<article class="card">
								<header class="card-head">
									<div class="titles">
										<h4 class="role">{item.role}</h4>
										<p class="org">
											{item.url ? (
												<a href={item.url} target="_blank" rel="noopener noreferrer">
													{item.org}
												</a>
											) : (
												item.org
											)}
										</p>
									</div>

									{(item.period || item.current) && (
										<span class="when">
											{item.current && <span class="dot" aria-hidden="true" />}
											{item.current ? (
												<span>
													{item.period && <span class="since">Since {item.period} · </span>}
													Present
												</span>
											) : (
												item.period
											)}
										</span>
									)}
								</header>

								<p class="desc">{item.description}</p>

								{item.bullets && (
									<ul class="bullets">
										{item.bullets.map((b) => (
											<li>{b}</li>
										))}
									</ul>
								)}

								{item.tags && (
									<ul class="tag-list" aria-label="Skills">
										{item.tags.map((t) => (
											<li>{t}</li>
										))}
									</ul>
								)}
							</article>
						</li>
					))}
				</ol>
			</section>
		))
	}

	{
		hasMore && (
			<div class="more-row">
				<a class="ghost-btn" href="/exp">
					View all {experiences.length} roles
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-width="2" stroke-linecap="square" />
					</svg>
				</a>
			</div>
		)
	}

	<div class="block">
		<h3 class="group-label">Awards &amp; recognition</h3>
		<ul class="award-grid">
			{
				awards.map((a) => (
					<li class="award reveal">
						<span class="award-icon" aria-hidden="true">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z" stroke-width="1.8" stroke-linejoin="round" />
								<path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3" stroke-width="1.8" stroke-linecap="round" />
							</svg>
						</span>
						<span class="award-text">
							<span class="award-result">{a.result}</span>
							<span class="award-event">{a.event}</span>
						</span>
						{a.year && <span class="award-year">{a.year}</span>}
					</li>
				))
			}
		</ul>
	</div>

	<div class="block">
		<h3 class="group-label">
			Hackathons &amp; competitions
			<span class="group-count dot-type">{competitions.length}</span>
		</h3>
		<ul class="comp-list">
			{
				competitions.map((c) => (
					<li class="comp reveal">
						<span class="comp-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<span class="comp-text">
							<span class="comp-name">{c.name}</span>
							{c.detail && <span class="comp-detail">{c.detail}</span>}
						</span>
						{c.years && (
							<span class="comp-years">
								{c.years.map((y) => (
									<span class="award-year">{y}</span>
								))}
							</span>
						)}
					</li>
				))
			}
		</ul>
	</div>

	{
		organizations.length > 0 && (
			<div class="also">
				<span class="also-label">Also a member of</span>
				{organizations.map((org) => (
					<span class="aff">
						{org.logo ? (
							<img src={org.logo} alt="" width="22" height="22" loading="lazy" />
						) : (
							<span class="initials small">{org.initials}</span>
						)}
						{org.name}
					</span>
				))}
			</div>
		)
	}
</div>


<style>
	/* ---------- Highlights: joined stat blocks ---------- */
	.highlights {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1.5px solid var(--line-strong);
		border-left: 1.5px solid var(--line-strong);
		margin-bottom: clamp(2.25rem, 5vw, 3.25rem);
	}

	.highlight {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: clamp(1.1rem, 2.6vw, 1.6rem);
		background: var(--card);
		border-right: 1.5px solid var(--line-strong);
		border-bottom: 1.5px solid var(--line-strong);
	}

	.hl-no {
		font-family: var(--f-mono);
		font-size: 0.62rem;
		letter-spacing: 0.18em;
		color: var(--muted);
	}

	.highlight-label {
		font-size: clamp(2rem, 4.6vw, 3rem);
		line-height: 0.95;
		color: var(--fg);
	}

	.highlight:first-child .highlight-label {
		color: var(--red-text);
	}

	.highlight-detail {
		font-family: var(--f-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		line-height: 1.5;
		color: var(--muted);
	}

	/* ---------- Group headings ---------- */
	.group + .group {
		margin-top: clamp(2rem, 4.5vw, 2.75rem);
	}

	.group-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.1rem;
		font-family: var(--f-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.group-label::after {
		content: '';
		flex: 1;
		height: 1.5px;
		background: var(--line-strong);
	}

	.group-count {
		font-size: 1.15rem;
		letter-spacing: 0;
		color: var(--red-text);
	}

	/* ---------- Timeline ---------- */
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.entry {
		--avatar: 46px;
		position: relative;
		display: grid;
		grid-template-columns: var(--avatar) minmax(0, 1fr);
		gap: clamp(0.9rem, 2.2vw, 1.4rem);
		padding-bottom: clamp(1rem, 2.4vw, 1.4rem);
	}

	/* Dotted rail, Nothing-style, joining one marker to the next. */
	.entry::before {
		content: '';
		position: absolute;
		left: calc(var(--avatar) / 2 - 1px);
		top: calc(var(--avatar) + 6px);
		bottom: 6px;
		width: 2px;
		background-image: radial-gradient(circle, var(--muted) 1px, transparent 1.2px);
		background-size: 2px 7px;
	}

	.entry:last-child {
		padding-bottom: 0;
	}

	.entry:last-child::before {
		display: none;
	}

	.avatar-wrap {
		position: relative;
		z-index: 1;
		width: var(--avatar);
		height: var(--avatar);
	}

	.avatar {
		width: var(--avatar);
		height: var(--avatar);
		overflow: hidden;
		display: grid;
		place-items: center;
		background: var(--card-2);
		border: 1.5px solid var(--line-strong);
		transition:
			border-color 0.3s var(--ease),
			transform 0.4s var(--ease);
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: grayscale(1);
		transition: filter 0.4s var(--ease);
	}

	.avatar.inset {
		background: #ffffff;
	}

	.avatar.inset img {
		object-fit: contain;
		padding: 20%;
	}

	.entry:hover .avatar {
		border-color: var(--red);
		transform: rotate(-4deg);
	}

	.entry:hover .avatar img {
		filter: none;
	}

	.initials {
		font-family: var(--f-dot);
		font-weight: 900;
		font-size: 1.1rem;
		color: var(--fg);
	}

	.card {
		position: relative;
		padding: clamp(1rem, 2.6vw, 1.4rem) clamp(1rem, 2.8vw, 1.5rem);
		background: var(--card);
		border: 1.5px solid var(--line-strong);
		box-shadow: 0 0 0 var(--hard);
		transition:
			transform 0.35s var(--ease),
			box-shadow 0.35s var(--ease);
	}

	.entry:hover .card {
		transform: translate(-4px, -4px);
		box-shadow: 4px 4px 0 var(--hard);
	}

	.card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		flex-wrap: wrap;
	}

	.titles {
		min-width: 0;
		flex: 1 1 16rem;
	}

	.role {
		margin: 0;
		font-family: var(--f-head);
		font-weight: 700;
		font-size: clamp(1.1rem, 2.2vw, 1.3rem);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.org {
		margin: 0.25rem 0 0;
		font-family: var(--f-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--red-text);
	}

	.org a {
		text-decoration: none;
	}

	.org a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.when {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
		padding: 0.32rem 0.6rem;
		border: 1px solid var(--line-strong);
		font-family: var(--f-mono);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		line-height: 1;
		white-space: nowrap;
	}

	.since {
		color: var(--muted);
	}

	.dot {
		position: relative;
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--red);
	}

	.dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1.5px solid var(--red);
		animation: ripple 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ripple {
		from {
			transform: scale(1);
			opacity: 0.8;
		}
		to {
			transform: scale(2.8);
			opacity: 0;
		}
	}

	.desc {
		margin: 0.75rem 0 0;
		max-width: 68ch;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.bullets {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
		max-width: 72ch;
	}

	.bullets li {
		position: relative;
		padding-left: 1.2rem;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.bullets li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		background: var(--red);
	}

	.card .tag-list {
		margin-top: 0.95rem;
	}

	/* ---------- Awards: joined box score ---------- */
	.block {
		margin-top: clamp(2.5rem, 5.5vw, 3.5rem);
	}

	.award-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1.5px solid var(--line-strong);
		border-left: 1.5px solid var(--line-strong);
	}

	.award {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 1rem 1.1rem;
		background: var(--card);
		border-right: 1.5px solid var(--line-strong);
		border-bottom: 1.5px solid var(--line-strong);
		transition: background-color 0.3s var(--ease);
	}

	/* Keep the 3-column grid even by widening the top award when needed. */
	.award:first-child:nth-last-child(3n + 1) {
		grid-column: 1 / -1;
	}

	.award:first-child:nth-last-child(3n + 2) {
		grid-column: span 2;
	}

	.award:hover {
		background: var(--card-2);
	}

	.award-icon {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		flex-shrink: 0;
		color: #fff;
		background: var(--red);
	}

	.award-text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}

	.award-result {
		font-family: var(--f-head);
		font-weight: 700;
		font-size: 1rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.award-event {
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.award-year {
		flex-shrink: 0;
		font-family: var(--f-dot);
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--fg);
	}

	/* ---------- Competitions: results column ---------- */
	.comp-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(1.5rem, 3.5vw, 2.5rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.comp {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.85rem 0;
		border-bottom: 1px dashed var(--line);
	}

	.comp-icon {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		flex-shrink: 0;
		border: 1.5px solid var(--line-strong);
		color: var(--fg);
		transition:
			background-color 0.3s var(--ease),
			color 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}

	.comp:hover .comp-icon {
		background: var(--red);
		border-color: var(--red);
		color: #fff;
	}

	.comp-text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		flex: 1;
	}

	.comp-name {
		font-family: var(--f-head);
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.3;
	}

	.comp-detail {
		font-size: 0.88rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.comp-years {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.5rem;
		flex-shrink: 0;
		max-width: 45%;
	}

	/* ---------- Also a member of ---------- */
	.also {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: clamp(1.5rem, 3.5vw, 2rem);
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}

	.also-label {
		font-family: var(--f-mono);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.aff {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.8rem 0.35rem 0.4rem;
		border: 1px solid var(--line);
		font-family: var(--f-head);
		font-size: 0.85rem;
	}

	.aff img {
		width: 22px;
		height: 22px;
		object-fit: cover;
	}

	.initials.small {
		font-size: 0.65rem;
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 900px) {
		.award-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.highlights,
		.comp-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		.entry {
			--avatar: 36px;
		}
		.award-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.award:first-child:nth-last-child(n) {
			grid-column: auto;
		}
		.entry:hover .card {
			transform: none;
			box-shadow: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot::after {
			animation: none;
			opacity: 0;
		}
	}
</style>
