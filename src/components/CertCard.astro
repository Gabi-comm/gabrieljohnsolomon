---
/**
 * One certificate as a newspaper clipping: silver-toned scan that comes into
 * full colour on hover, with a mono caption. The whole card links to the
 * full-resolution image (or a verifiable-credential URL when present), in a new tab.
 *
 * Shared by the home highlight row and the full /certificates gallery.
 */
import type { Certification } from '../data/certifications';

interface Props {
	cert: Certification;
}

const { cert } = Astro.props;
---

<a
	class="clipping reveal"
	href={cert.credentialUrl ?? cert.image}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`${cert.name} — view certificate`}
>
	<div class="shot">
		<img src={cert.image} alt={`${cert.name} certificate`} loading="lazy" decoding="async" />
	</div>
	<div class="cap">
		<span class="cat">{cert.category}</span>
		<span class="cert-name">{cert.name}</span>
		<span class="view" aria-hidden="true">↗</span>
	</div>
</a>

<style>
	.clipping {
		--shadow: var(--hard);
		display: flex;
		flex-direction: column;
		background: var(--card);
		border: 1.5px solid var(--line-strong);
		text-decoration: none;
		color: inherit;
		box-shadow: 0 0 0 var(--shadow);
		transition:
			transform 0.35s var(--ease),
			box-shadow 0.35s var(--ease);
	}

	.clipping:hover {
		transform: translate(-5px, -5px);
		box-shadow: 5px 5px 0 var(--shadow);
	}

	/* Contained, never cropped, so certificate text stays legible. */
	.shot {
		aspect-ratio: 4 / 3;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-bottom: 1.5px solid var(--line-strong);
		background-color: var(--card-2);
		background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
		background-size: 10px 10px;
	}

	.shot img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
		filter: grayscale(1) contrast(1.05);
		transition:
			filter 0.5s var(--ease),
			transform 0.6s var(--ease);
	}

	.clipping:hover .shot img {
		filter: none;
		transform: scale(1.03);
	}

	.cap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.25rem 0.75rem;
		padding: 0.85rem 1rem 1rem;
	}

	.cat {
		grid-column: 1 / -1;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--red-text);
	}

	.cert-name {
		font-family: var(--f-head);
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.view {
		align-self: end;
		font-family: var(--f-mono);
		color: var(--muted);
		transition:
			transform 0.3s var(--ease),
			color 0.3s var(--ease);
	}

	.clipping:hover .view {
		color: var(--red-text);
		transform: translate(2px, -2px);
	}
</style>
