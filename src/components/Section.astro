---
/**
 * Shared shell for every home-page section, so headings, spacing and the glass
 * panel treatment stay consistent as sections are added.
 */
interface Props {
	/** Small uppercase label above the heading. */
	eyebrow?: string;
	title: string;
	subtitle?: string;
	/** Anchor target, for linking straight to a section. */
	id?: string;
	/** Render without the glass panel — used when children bring their own cards. */
	bare?: boolean;
}

const { eyebrow, title, subtitle, id, bare = false } = Astro.props;
---

<section class="section" id={id}>
	<header class="section-head">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h2 class="section-title">{title}</h2>
		{subtitle && <p class="section-sub">{subtitle}</p>}
	</header>

	<div class:list={['section-body', { panel: !bare }]}>
		<slot />
	</div>
</section>

<style>
	.section {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		margin-block: clamp(3.5rem, 9vw, 7rem);
		box-sizing: border-box;
	}

	.section-head {
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
		text-align: center;
	}

	.eyebrow {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--pp);
		margin: 0 0 0.6rem;
		opacity: 1;
	}

	.section-title {
		font-family: 'pop-bold', system-ui, sans-serif;
		font-size: clamp(1.6rem, 4.5vw, 2.4rem);
		line-height: 1.15;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.section-sub {
		font-family: 'pop-thin', system-ui, sans-serif;
		font-size: clamp(0.9rem, 2.2vw, 1rem);
		color: var(--muted);
		max-width: 56ch;
		margin: 0.75rem auto 0;
		line-height: 1.6;
		opacity: 1;
	}

	.panel {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding: clamp(1.1rem, 3.5vw, 2rem);
		box-shadow: 0 8px 32px rgb(0 0 0 / 0.25);
	}
</style>
