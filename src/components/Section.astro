---
/**
 * A home-page section set like a broadsheet article: a heavy double rule, a
 * dot-matrix section number and kicker, a big grotesk headline and an italic
 * dek. `bare` drops the boxed panel for children that bring their own cards.
 */
interface Props {
	/** Section kicker, e.g. "Featured work". */
	eyebrow?: string;
	title?: string;
	subtitle?: string;
	id?: string;
	/** Dot-matrix section number, e.g. "03". */
	num?: string;
	bare?: boolean;
}

const { eyebrow, title, subtitle, id, num, bare = false } = Astro.props;
---

<section class="np-section" id={id}>
	<header class="np-head reveal">
		<hr class="double-rule" />
		<div class="np-meta">
			{num && <span class="np-no dot-type">№{num}</span>}
			{eyebrow && <span class="kicker"><span class="rdot"></span>{eyebrow}</span>}
			<span class="np-fill" aria-hidden="true"></span>
		</div>
		{title && <h2 class="np-title">{title}</h2>}
		{subtitle && <p class="np-dek">{subtitle}</p>}
	</header>

	<div class:list={['np-body', { panel: !bare }]}>
		<slot />
	</div>
</section>

<style>
	.np-section {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
		margin-block: clamp(3.5rem, 9vw, 6.5rem);
	}

	.np-head {
		margin-bottom: clamp(1.4rem, 3.5vw, 2.25rem);
	}

	.np-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--line);
	}

	.np-no {
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		line-height: 1;
		color: var(--fg);
	}

	/* Dotted leader running to the edge, like a table of contents line. */
	.np-fill {
		flex: 1;
		height: 2px;
		background-image: radial-gradient(circle, var(--line-strong) 0.9px, transparent 1.1px);
		background-size: 6px 2px;
		opacity: 0.45;
	}

	.np-title {
		font-family: var(--f-head);
		font-weight: 700;
		font-size: clamp(1.9rem, 5vw, 3.4rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		margin: clamp(0.9rem, 2.2vw, 1.4rem) 0 0;
		max-width: 22ch;
		text-wrap: balance;
	}

	.np-dek {
		font-style: italic;
		font-size: clamp(1rem, 2.1vw, 1.2rem);
		line-height: 1.5;
		color: var(--muted);
		max-width: 60ch;
		margin: 0.7rem 0 0;
	}

	.panel {
		background: var(--card);
		border: 1.5px solid var(--line-strong);
		padding: clamp(1.1rem, 3.5vw, 2rem);
	}
</style>
